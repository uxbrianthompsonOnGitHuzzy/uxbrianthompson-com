---
import CaseStudy from "../components/CaseStudy.astro";
const summary = "The brief was deceptively simple: create the coolest experience on the planet. Dreamforce was already the largest software conference in the world — 170,000 people, 3,500 breakout sessions, 17 locations across San Francisco, and 10 million more watching online. The challenge was not scale. It was coherence: how do you give one person a single, connected experience across all of it? We did not build an event app. We built a year-long platform.";
const bullets = [
  "170,000+ registered on-site attendees across 17 San Francisco locations — unified by a single personalized agenda and wayfinding system",
  "10,000,000+ online participants connected through the unified digital experience, with AI guide support across all surfaces",
  "163,000,000 social impressions generated during the event — driven by structured content moments designed into the experience architecture",
  "Personalized super agenda builder: role, cloud, company size, and goal inputs generated a fully sequenced three-day agenda with geography and timing already resolved",
];
const sections = [
  { heading: "170,000 people needed different experiences, not a bigger event.", body: "Dreamforce's scale was its design problem. With 3,500 sessions across 17 locations, attendees faced genuine decision paralysis. The super agenda builder was not a scheduling tool — it was a translation layer between Salesforce's full product catalog and what this specific person, in this specific role, at this specific company, should see and do. The output was not a list. It was a day — with geography, timing, and priority already resolved." },
  { heading: "Not a notification relay. A full action layer built on a conversational interface.", body: "The AI guide was positioned as a first-class product — the intersection of product information, agenda assistance, and live session context, all in one conversational interface. During keynotes, it surfaced relevant product context. Between sessions, it recommended next steps based on what you had engaged with. After the event, it became the mechanism for continuing the Trailblazer Journey. This was 2016 to 2018. The conversational AI patterns being designed then were genuinely ahead of what the industry considered standard for enterprise events." },
  { heading: "From three days to twelve months.", body: "The year-long engagement model was the most ambitious design decision in the project. The Dreamforce experience was designed explicitly as the entry point for a cyclical user journey — not a standalone event. Attendees left with a personalized product recommendation profile, a continued relationship with the AI guide, and an on-ramp to Trailhead seeded with what they had expressed interest in at Dreamforce. The event was the peak. The platform was the product." },
];
const takeaways = [
  "Scale is a design problem before it is a logistics problem. 170,000 people needed different experiences, not a bigger event. Personalization was the architecture, not the feature.",
  "The seam between digital and physical is a first-class design surface. Getting the handoff right — from phone to room to session to city block — required designing both sides simultaneously with the same information architecture. When it works, people do not notice. When it fails, they blame the event.",
  "Events are temporal products. Platforms are durable ones. The most important design decision was to design the experience for the year, not the weekend. The three days at Dreamforce were the acquisition moment. The platform was the retention strategy.",
  "Conversational AI in enterprise contexts requires a trust model, not just an interface. The AI guide worked because it was positioned as a knowledgeable colleague with a specific area of expertise — not a general-purpose assistant. That specificity made it trustworthy. That trust model is one I have been refining ever since.",
];
---
<CaseStudy
  title="Dreamforce"
  eyebrow="Salesforce"
  role="Group Creative Director via Agency"
  year="2016–2018"
  summary={summary}
  bullets={bullets}
  sections={sections}
  takeaways={takeaways}
  imageStart={91}
  prevCase={{ title: "Audi", href: "/audi", eyebrow: "Audi" }}
  nextCase={{ title: "Crunchyroll", href: "/funimation", eyebrow: "Crunchyroll" }}
    images={[
      "/images/dreamforce-hero.jpg",  // hero (16:9 crop)
      "/images/dreamforce-section-1.png",  // section 1 (3:2 crop)
      "/images/dreamforce-section-2.jpg",  // section 2 (3:2 crop)
      "/images/dreamforce-section-3.png",  // section 3 (3:2 crop)
      "/images/dreamforce-gallery-wide.png",  // gallery wide (16:9 crop)
      "/images/dreamforce-gallery-detail.jpg",  // gallery detail (full height)
    ]}
/>
