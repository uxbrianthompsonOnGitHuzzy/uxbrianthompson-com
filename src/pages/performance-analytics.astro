---
import CaseStudy from "../components/CaseStudy.astro";
const summary = "Advisors using Salesforce FSC could see what a client held. They could not see, at a glance, how those holdings were performing. Portfolio Performance added a native performance tab to the Client 360 record — powered by BridgeFT custodial data flowing through Data Cloud — so that performance visibility lives where advisors already work, not in a separate analytics application. Drift detected here becomes an urgency signal in Run My Day. Data that was siloed became a system.";
const bullets = [
  "Portfolio Performance tab added natively to Client 360 — no separate application, no context switch, performance data lives in the same record view as relationship data",
  "BridgeFT custodial data surfaced at the advisor's native surface via Data Cloud integration — time-weighted return, asset allocation, benchmark comparison, and period-over-period change",
  "Portfolio drift detected in Performance Analytics becomes the Portfolio Drift signal card in Run My Day — a direct connection between analytics visibility and proactive advisor action",
  "AI narrative layer generates a plain-language performance summary that advisors can use directly in client communications — reducing the synthesis work from hours to seconds",
];
const sections = [
  { heading: "A new tab, not a new application. Performance data lives in Client 360.", body: "The design decision to add a tab rather than a new page was not a technical shortcut — it was an architectural choice about where performance data belongs. Separating performance into a standalone tool would have created a context switch between relationship data and performance data that advisors would have to manually bridge. The tab keeps both in the same record, the same session, and the same mental model." },
  { heading: "Portfolio drift is not a metric. It is an action trigger.", body: "When the Performance Analytics tab detects that a client's portfolio has drifted meaningfully from target allocation, that drift does not stay on the analytics screen — it generates a Portfolio Drift signal card in Run My Day's Service group, ranked by urgency alongside all other advisor signals. Performance visibility and proactive advisor action are connected at the data layer, so that seeing a problem and acting on it are never separated by a tool switch." },
  { heading: "Einstein drafts the performance summary. The advisor sends it.", body: "The AI narrative layer generates a plain-language summary of a client's performance — time-weighted return context, period-over-period change, and benchmark comparison — in the tone of an advisor communication rather than an analytics report. Advisors can use it directly in a client email or review call, reducing the synthesis work that previously required manually pulling figures from multiple sources. The agent drafts; the human decides what to send." },
];
const takeaways = [
  "BridgeFT data brought to the advisor's surface means closing the loop between where the data lives (third-party custodian) and where the advisor works (FSC). The integration work is invisible to the advisor; the value is immediate.",
  "Household aggregation as the default view means performance is presented at the relationship level — all accounts, all holdings, all asset classes — before drilling to individual account detail. That matches how advisors think about client relationships.",
  "Drift as urgency signal, not just a metric, is the design decision that connects Performance Analytics to the broader FSC agentic system. A metric is informational. An urgency signal is actionable. The design treats one as the input for the other.",
  "The AI narrative as a communication accelerant is not automation — it is augmentation. The advisor still decides what to communicate and how. The agent removes the blank page.",
];
---
<CaseStudy
  title="Performance Analytics"
  eyebrow="Salesforce"
  role="Senior Product Designer"
  year="2024–2025"
  summary={summary}
  bullets={bullets}
  sections={sections}
  takeaways={takeaways}
  imageStart={25}
  prevCase={{ title: "Meeting 360", href: "/meeting-360", eyebrow: "Salesforce" }}
  nextCase={{ title: "Advisor Anywhere", href: "/advisor-anywhere", eyebrow: "Salesforce" }}
/>
