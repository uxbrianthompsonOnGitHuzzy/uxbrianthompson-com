---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---
<BaseLayout>
  <Nav />
  <section style="padding:72px 48px 48px;">
    <h1 class="font-display" style="font-size:clamp(3.5rem,9vw,8rem);line-height:.93;letter-spacing:-.01em;color:var(--text);margin:0 0 24px;">Designing the<br/>Intelligence<br/>Layer of Finance</h1>
    <p style="font-size:16px;color:var(--blue-md);max-width:520px;line-height:1.7;margin:0;font-family:'Inter',sans-serif;">Sr. Product Designer at Salesforce FSC — 56 features shipped, 17 zero-to-one AI innovations, 11 active enterprise pilots.</p>
  </section>
  <section style="padding:0 48px 96px;">
    <a href="/fsc" style="display:block;background:#0d1b34;border-radius:20px;text-decoration:none;margin-bottom:12px;position:relative;overflow:hidden;">
      <span style="position:absolute;top:24px;right:24px;font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#4ade80;border:1px solid #4ade80;padding:3px 10px;border-radius:100px;font-family:'Inter',sans-serif;">Live · Evolving</span>
      <div style="padding:40px;min-height:360px;display:flex;flex-direction:column;justify-content:space-between;">
        <div class="placeholder" style="height:180px;">Hero video — FSC</div>
        <div style="margin-top:32px;">
          <div style="font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:8px;font-family:'Inter',sans-serif;">Featured · Salesforce FSC</div>
          <h2 class="font-display" style="font-size:clamp(2rem,5vw,4rem);color:#fff;margin:0 0 8px;line-height:1;">FSC Agentic Experience</h2>
          <p style="font-size:13px;color:var(--blue-dim);margin:0;font-family:'Inter',sans-serif;">Reinventing Financial Services — AI-powered workflows for wealth advisors</p>
        </div>
      </div>
    </a>
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:12px;">
      <a href="/run-my-day" style="display:block;background:#111f3d;border:1px solid var(--border);border-radius:14px;text-decoration:none;"><div style="padding:16px;height:140px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:70px;font-size:0;">img</div><span class="font-display" style="color:#fff;font-size:13px;line-height:1.15;">Run My Day</span></div></a>
      <a href="/meeting-360" style="display:block;background:#111f3d;border:1px solid var(--border);border-radius:14px;text-decoration:none;"><div style="padding:16px;height:140px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:70px;font-size:0;">img</div><span class="font-display" style="color:#fff;font-size:13px;line-height:1.15;">Meeting 360</span></div></a>
      <a href="/performance-analytics" style="display:block;background:#111f3d;border:1px solid var(--border);border-radius:14px;text-decoration:none;"><div style="padding:16px;height:140px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:70px;font-size:0;">img</div><span class="font-display" style="color:#fff;font-size:13px;line-height:1.15;">Performance Analytics</span></div></a>
      <a href="/advisor-anywhere" style="display:block;background:#111f3d;border:1px solid var(--border);border-radius:14px;text-decoration:none;"><div style="padding:16px;height:140px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:70px;font-size:0;">img</div><span class="font-display" style="color:#fff;font-size:13px;line-height:1.15;">Advisor Anywhere</span></div></a>
      <a href="/integration-hub" style="display:block;background:#111f3d;border:1px solid var(--border);border-radius:14px;text-decoration:none;"><div style="padding:16px;height:140px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:70px;font-size:0;">img</div><span class="font-display" style="color:#fff;font-size:13px;line-height:1.15;">Integration Hub</span></div></a>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
      <a href="/bank-of-america" style="display:block;background:#5c1520;border-radius:16px;text-decoration:none;"><div style="padding:28px;height:240px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:90px;font-size:0;">logo</div><div><div style="font-size:10px;color:rgba(255,255,255,.3);font-family:'Inter',sans-serif;margin-bottom:4px;">02</div><h3 class="font-display" style="font-size:2rem;color:#fff;margin:0 0 4px;line-height:1.05;">Bank of America</h3><p style="font-size:12px;color:rgba(255,255,255,.4);margin:0;font-family:'Inter',sans-serif;">Erica AI · Sr. Product Designer</p></div></div></a>
      <a href="/google" style="display:block;background:#1e2d1f;border-radius:16px;text-decoration:none;"><div style="padding:28px;height:240px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:90px;font-size:0;">logo</div><div><div style="font-size:10px;color:rgba(255,255,255,.3);font-family:'Inter',sans-serif;margin-bottom:4px;">03</div><h3 class="font-display" style="font-size:2rem;color:#fff;margin:0 0 4px;line-height:1.05;">Google</h3><p style="font-size:12px;color:rgba(255,255,255,.4);margin:0;font-family:'Inter',sans-serif;">Pixel Hardware · Sr. Experience Designer</p></div></div></a>
    </div>
    <div style="margin-top:32px;">
      <p style="font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--blue-dim);margin:0 0 12px;font-family:'Inter',sans-serif;">Earlier Work</p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
        <a href="/funimation" style="display:block;background:#2d1050;border-radius:14px;text-decoration:none;"><div style="padding:24px;height:190px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:80px;font-size:0;">logo</div><div><h3 class="font-display" style="font-size:1.5rem;color:#fff;margin:0 0 3px;">Funimation</h3><p style="font-size:11px;color:rgba(255,255,255,.35);margin:0;font-family:'Inter',sans-serif;">Design Director</p></div></div></a>
        <a href="/apple" style="display:block;background:#1e1e22;border-radius:14px;text-decoration:none;"><div style="padding:24px;height:190px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:80px;font-size:0;">logo</div><div><h3 class="font-display" style="font-size:1.5rem;color:#fff;margin:0 0 3px;">Apple</h3><p style="font-size:11px;color:rgba(255,255,255,.35);margin:0;font-family:'Inter',sans-serif;">Apple Watch · Assoc. Creative Director</p></div></div></a>
        <a href="/audi" style="display:block;background:#1a1520;border-radius:14px;text-decoration:none;"><div style="padding:24px;height:190px;display:flex;flex-direction:column;justify-content:space-between;"><div class="placeholder" style="height:80px;font-size:0;">logo</div><div><h3 class="font-display" style="font-size:1.5rem;color:#fff;margin:0 0 3px;">Audi</h3><p style="font-size:11px;color:rgba(255,255,255,.35);margin:0;font-family:'Inter',sans-serif;">FWA Award · Assoc. Creative Director</p></div></div></a>
      </div>
    </div>
  </section>
</BaseLayout>