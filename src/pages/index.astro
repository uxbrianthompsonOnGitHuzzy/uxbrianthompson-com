---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---
<BaseLayout>
  <Nav />
  <section style="padding:72px 48px 48px;">
    <h1 class="font-display" style="font-size:clamp(3.5rem,9vw,8rem); line-height:0.93; letter-spacing:-0.01em; color:var(--text); margin:0 0 24px;">
      Designing the<br/>Intelligence<br/>Layer of Finance
    </h1>
    <p style="font-size:16px; color:var(--accent-dim); max-width:520px; line-height:1.7; margin:0;">
      Sr. Product Designer at Salesforce FSC — 56 features shipped,
      17 zero-to-one AI innovations, 11 active enterprise pilots.
    </p>
  </section>
  <section style="padding:0 48px 96px;">
    <a href="/fsc" style="display:block; background:var(--surface); border-radius:20px; text-decoration:none; margin-bottom:12px; position:relative; overflow:hidden; transition:transform 0.3s;"
       onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
      <span style="position:absolute; top:24px; right:24px; font-size:9px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--accent); border:1px solid var(--accent); padding:3px 10px; border-radius:100px;">Live · Evolving</span>
      <div style="padding:40px; min-height:380px; display:flex; flex-direction:column; justify-content:space-between;">
        <div class="placeholder" style="height:200px; border-radius:14px;">Hero video / Figma export — FSC</div>
        <div style="margin-top:32px;">
          <div style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--accent-dim); margin-bottom:8px; font-family:'Inter',sans-serif; opacity:0.7;">Featured · Salesforce FSC</div>
          <h2 class="font-display" style="font-size:clamp(2rem,5vw,4rem); color:var(--text); margin:0 0 8px; line-height:1;">FSC Agentic Experience</h2>
          <p style="font-size:13px; color:var(--accent-dim); margin:0; opacity:0.75;">Reinventing Financial Services — AI-powered workflows for wealth advisors</p>
        </div>
      </div>
    </a>
    <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:12px;">
      {[
        { title: 'Run My Day',            href: '/run-my-day' },
        { title: 'Meeting 360',           href: '/meeting-360' },
        { title: 'Performance Analytics', href: '/performance-analytics' },
        { title: 'Advisor Anywhere',      href: '/advisor-anywhere' },
        { title: 'Integration Hub',       href: '/integration-hub' },
      ].map(exp => (
        <a href={exp.href} style="display:block; background:var(--surface-raised); border:1px solid var(--border); border-radius:14px; text-decoration:none; transition:transform 0.2s;"
           onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
          <div style="padding:16px; height:140px; display:flex; flex-direction:column; justify-content:space-between;">
            <div class="placeholder" style="height:72px; border-radius:8px; font-size:0;">img</div>
            <span class="font-display" style="color:var(--text); font-size:13px; line-height:1.15;">{exp.title}</span>
          </div>
        </a>
      ))}
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
      <a href="/bank-of-america" style="display:block; background:#3a2042; border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; height:260px; display:flex; flex-direction:column; justify-content:space-between;">
          <div class="placeholder" style="height:100px; border-radius:10px; font-size:0;">logo</div>
          <div>
            <div style="font-size:10px; color:rgba(242,233,228,0.3); font-family:'Inter',sans-serif; margin-bottom:6px;">02</div>
            <h3 class="font-display" style="font-size:2rem; color:var(--text); margin:0 0 4px; line-height:1.05;">Bank of America</h3>
            <p style="font-size:12px; color:rgba(242,233,228,0.4); margin:0; font-family:'Inter',sans-serif;">Erica AI · Sr. Product Designer</p>
          </div>
        </div>
      </a>
      <a href="/google" style="display:block; background:#1e3040; border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; height:260px; display:flex; flex-direction:column; justify-content:space-between;">
          <div class="placeholder" style="height:100px; border-radius:10px; font-size:0;">logo</div>
          <div>
            <div style="font-size:10px; color:rgba(242,233,228,0.3); font-family:'Inter',sans-serif; margin-bottom:6px;">03</div>
            <h3 class="font-display" style="font-size:2rem; color:var(--text); margin:0 0 4px; line-height:1.05;">Google</h3>
            <p style="font-size:12px; color:rgba(242,233,228,0.4); margin:0; font-family:'Inter',sans-serif;">Pixel Hardware · Sr. Experience Designer</p>
          </div>
        </div>
      </a>
    </div>
    <div style="margin-top:36px;">
      <p style="font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--accent-dim); margin:0 0 12px; font-family:'Inter',sans-serif;">Earlier Work</p>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">
        {[
          { label: 'Funimation', href: '/funimation', bg: '#2d1c42', role: 'Design Director' },
          { label: 'Apple',      href: '/apple',      bg: '#252338', role: 'Apple Watch · Assoc. Creative Director' },
          { label: 'Audi',       href: '/audi',       bg: '#27213a', role: 'FWA Award · Assoc. Creative Director' },
        ].map(item => (
          <a href={item.href} style={`display:block; background:${item.bg}; border-radius:14px; text-decoration:none; transition:transform 0.3s;`}
             onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
            <div style="padding:24px; height:200px; display:flex; flex-direction:column; justify-content:space-between;">
              <div class="placeholder" style="height:80px; border-radius:8px; font-size:0;">logo</div>
              <div>
                <h3 class="font-display" style="font-size:1.6rem; color:var(--text); margin:0 0 4px; line-height:1;">{item.label}</h3>
                <p style="font-size:11px; color:rgba(242,233,228,0.35); margin:0; font-family:'Inter',sans-serif;">{item.role}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
