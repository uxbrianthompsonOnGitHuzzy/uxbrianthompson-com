---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---
<BaseLayout
  title="Brian Thompson — Senior Product Designer, Human–AI Systems & Agentic Workflows"
  description="Senior Product Designer specializing in AI-native product design, agentic workflows, and decision intelligence. Currently designing intelligent systems for wealth advisors at Salesforce FSC."
>
  <Nav />

  <style>
    .home-hero    { padding: 40px 48px; }
    .home-grid    { padding: 0 48px 96px; }
    @media (max-width: 700px) {
      .home-hero  { padding: 28px 24px 20px; }
      .home-grid  { padding: 0 24px 64px; }
    }
  </style>

  <section class="home-hero">
    <h1 class="font-display" style="font-size:clamp(3rem,9vw,8rem); line-height:0.93; letter-spacing:-0.01em; color:var(--text); margin:0 0 24px;">
      Designing the<br/>Intelligence<br/>Layer of Finance
    </h1>
    <p style="font-size:16px; color:var(--text-dim); max-width:520px; line-height:1.7; margin:0;">
      Sr. Product Designer at Salesforce FSC — 56 features shipped,
      17 zero-to-one AI innovations, 11 active enterprise pilots.
    </p>
  </section>

  <section class="home-grid">

    <!-- Featured label -->
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 16px; font-family:'Inter',sans-serif;">Featured</p>

    <!-- Salesforce dark container -->
    <div style="background:#504e4b; border-radius:20px; padding:16px; margin-bottom:80px;">

      <a href="/fsc" style="display:block; background:var(--dim-grey); border-radius:14px; text-decoration:none; margin-bottom:10px; position:relative; overflow:hidden; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <span style="position:absolute; top:20px; right:20px; font-size:9px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--parchment); border:1px solid var(--parchment); padding:3px 10px; border-radius:100px; opacity:0.6;">Live · Evolving</span>
        <div style="padding:36px;">
          <div class="placeholder" style="width:100%; aspect-ratio:16/9; border-radius:12px; height:auto;">Hero video / Figma export — FSC</div>
          <div style="margin-top:28px;">
            <div style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); margin-bottom:8px; font-family:'Inter',sans-serif;">Salesforce</div>
            <h2 class="font-display" style="font-size:clamp(2rem,5vw,4rem); color:var(--parchment); margin:0 0 8px; line-height:1;">FSC Agentic Experience</h2>
            <p style="font-size:13px; color:var(--silver); margin:0;">Reinventing Financial Services — AI-powered workflows for wealth advisors</p>
          </div>
        </div>
      </a>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(120px, 1fr)); gap:10px;">
        {[
          { title: 'Run My Day',            href: '/run-my-day', imgNum: 13 },
          { title: 'Meeting 360',           href: '/meeting-360', imgNum: 19 },
          { title: 'Performance Analytics', href: '/performance-analytics', imgNum: 25 },
          { title: 'Advisor Anywhere',      href: '/advisor-anywhere', imgNum: 31 },
          { title: 'Integration Hub',       href: '/integration-hub', imgNum: 37 },
        ].map(exp => (
          <a href={exp.href} style="display:block; background:var(--silver); border-radius:12px; text-decoration:none; transition:transform 0.2s;"
             onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
            <div style="padding:12px; display:flex; flex-direction:column; gap:10px;">
              <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:8px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">{exp.imgNum}</span></div>
              <span class="font-display" style="color:var(--dark-warm); font-size:12px; line-height:1.15;">{exp.title}</span>
            </div>
          </a>
        ))}
      </div>

    </div>

        <!-- 2023-2025 -->
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 16px; font-family:'Inter',sans-serif;">2023 – 2025</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-bottom:80px;">

      <a href="/wealth-agents" style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; display:flex; flex-direction:column; gap:20px;">
          <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:10px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">43</span></div>
          <div>
            <h3 class="font-display" style="font-size:2rem; color:var(--dim-grey); margin:0 0 4px; line-height:1.05;">Wealth Agents</h3>
            <p style="font-size:12px; color:rgba(58,56,53,0.4); margin:0; font-family:'Inter',sans-serif;">Salesforce</p>
          </div>
        </div>
      </a>

      <a href="/systems-design" style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; display:flex; flex-direction:column; gap:20px;">
          <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:10px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">49</span></div>
          <div>
            <h3 class="font-display" style="font-size:2rem; color:var(--dim-grey); margin:0 0 4px; line-height:1.05;">Systems Design</h3>
            <p style="font-size:12px; color:rgba(58,56,53,0.4); margin:0; font-family:'Inter',sans-serif;">Salesforce</p>
          </div>
        </div>
      </a>

      <a href="/xfn-alignment" style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; display:flex; flex-direction:column; gap:20px;">
          <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:10px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">55</span></div>
          <div>
            <h3 class="font-display" style="font-size:2rem; color:var(--dim-grey); margin:0 0 4px; line-height:1.05;">XFN Alignment</h3>
            <p style="font-size:12px; color:rgba(58,56,53,0.4); margin:0; font-family:'Inter',sans-serif;">Salesforce</p>
          </div>
        </div>
      </a>

    </div>

    <!-- Earlier Work -->
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 16px; font-family:'Inter',sans-serif;">Earlier Work</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-bottom:80px;">
      <a href="/bank-of-america" style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; display:flex; flex-direction:column; gap:20px;">
          <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:10px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">61</span></div>
          <div>
            <h3 class="font-display" style="font-size:2rem; color:var(--dim-grey); margin:0 0 4px; line-height:1.05;">Bank of America</h3>
            <p style="font-size:12px; color:rgba(58,56,53,0.4); margin:0; font-family:'Inter',sans-serif;">Lending</p>
          </div>
        </div>
      </a>
      <a href="/google" style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:28px; display:flex; flex-direction:column; gap:20px;">
          <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:10px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">67</span></div>
          <div>
            <h3 class="font-display" style="font-size:2rem; color:var(--dim-grey); margin:0 0 4px; line-height:1.05;">Google</h3>
            <p style="font-size:12px; color:rgba(58,56,53,0.4); margin:0; font-family:'Inter',sans-serif;">Pixel Hardware</p>
          </div>
        </div>
      </a>
    </div>

    <!-- The Vault -->
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 16px; font-family:'Inter',sans-serif;">The Vault</p>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:12px;">
      {[
        { label: 'Crunchyroll', href: '/funimation',  role: 'FunimationCon', imgNum: 73 },
        { label: 'Apple',       href: '/apple',        role: 'Apple Watch', imgNum: 79 },
        { label: 'Audi',        href: '/audi',         role: 'AudiUSA.com', imgNum: 85 },
        { label: 'Dreamforce', href: '/dreamforce',  role: 'Dreamforce · 2016–2018', imgNum: 91 },
      ].map(item => (
        <a href={item.href} style="display:block; background:var(--soft-linen); border-radius:14px; text-decoration:none; transition:transform 0.3s;"
           onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
          <div style="padding:24px; display:flex; flex-direction:column; gap:16px;">
            <div class="placeholder" style="position:relative; width:100%; aspect-ratio:16/9; border-radius:8px; height:auto;"><span style="position:absolute;bottom:8px;right:10px;font-size:13px;font-weight:700;color:#fff;background:#cc00cc;padding:2px 8px;border-radius:3px;pointer-events:none;z-index:2;">{item.imgNum}</span></div>
            <div>
              <h3 class="font-display" style="font-size:1.6rem; color:var(--silver); margin:0 0 4px; line-height:1;">{item.label}</h3>
              <p style="font-size:11px; color:var(--silver); margin:0; font-family:'Inter',sans-serif; opacity:0.7;">{item.role}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

  </section>


  <!-- Footer -->
  <footer style="text-align:center; padding:40px 0;">

    <button onclick="window.scrollTo({top:0,behavior:'smooth'})"
      style="background:none; border:none; cursor:pointer; font-family:'Inter',sans-serif; font-size:11px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; color:var(--dim-grey); padding:0;">
      ↑ &nbsp; Back To Top &nbsp; ↑
    </button>

    <div style="margin-top:40px; display:flex; align-items:center; justify-content:center; gap:40px;">

      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/in/uxbrianthompson/" target="_blank" rel="noopener" aria-label="LinkedIn"
         style="color:var(--silver); transition:color 0.2s;"
         onmouseover="this.style.color='var(--dim-grey)'" onmouseout="this.style.color='var(--silver)'">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>

      <!-- Email -->
      <a href="mailto:uxbrianthompson@gmail.com" aria-label="Email"
         style="color:var(--silver); transition:color 0.2s;"
         onmouseover="this.style.color='var(--dim-grey)'" onmouseout="this.style.color='var(--silver)'">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>

    </div>

    <div style="margin-top:40px;"></div>

  </footer>
</BaseLayout>
