---
import CaseStudy from "../components/CaseStudy.astro";
const summary = "Before we reimagined the Agentic Wealth Experience at Salesforce FSC, we spent months with research, strategy, product management, design, sales, leadership, and our customers. What emerged was a mission: empower financial advisors with an intelligent digital ecosystem that unlocks trapped data, automates routine tasks, and delivers personalized guidance at scale. The four products that followed are not four features. They are one system.";
const bullets = [
  "56 features and enhancements shipped across the FSC agentic layer, spanning proactive intelligence, data integration, mobile advising, and performance analytics",
  "17 zero-to-one AI innovations — features and interaction models that had no prior precedent in wealth management software",
  "32 agentic contextual insights and actions surfaced across the advisor workflow, from morning triage to client meeting prep",
  "11 active customer pilot programs, including Schwab, BofA/Merrill Lynch, TIAA Wealth, EP Wealth, and Northern Trust — with 100% adoption desire among interviewees",
];
const sections = [
  { heading: "Jennifer Chen manages 100+ clients and $700M in AUM from her phone.", body: "She is the persona at the center of the FSC agentic design — mobile-first, relationship-driven, operating at a scale that makes manual triage structurally impossible. Every design decision in the FSC system was evaluated against her reality: does this surface the right client, at the right moment, with the right context to act?" },
  { heading: "Run My Day. Advisor Anywhere. Integration Hub. Portfolio Performance.", body: "Each product addresses a distinct layer of the advisor operating system. But they share an information architecture, a signal vocabulary, and a common urgency language — so that drift detected in Portfolio Performance becomes an insight card in Run My Day, and an action taken in Advisor Anywhere commits back to the FSC record. Coherence was the design requirement, not a nice-to-have." },
  { heading: "Together, these are not four features. They are one unified system.", body: "The FSC agentic layer is built on a principle borrowed from good infrastructure design: every input should be actionable, every action should be auditable, and every surface should know what the others know. The result is an advisor who arrives in the morning with the work already organized, who can act from Slack without opening the CRM, and whose performance data is already connected to the clients who need attention most." },
];
const takeaways = [
  "System thinking has to precede feature design. Until we mapped the data flows between products, each feature was a dead end. The coherence came from designing the connections, not the surfaces.",
  "Human-in-the-loop is the correct design stance in regulated industries. Every automation in the FSC system has a decision point. That is not a concession — it is the architecture.",
  "The all-clear state is a design deliverable, not an afterthought. When an advisor has addressed every signal, the system should confirm it. That emotional payoff is the reason people come back the next morning.",
  "Quantified pilot feedback is a design input. 100% adoption desire among interviewees is evidence that the design is hitting the right level of proactivity without becoming noise.",
];
---
<CaseStudy
  title="FSC Agentic Experience"
  eyebrow="Salesforce"
  role="Senior Product Designer"
  year="2023–2025"
  summary={summary}
  bullets={bullets}
  sections={sections}
  takeaways={takeaways}
  imageStart={7}
  prevCase={{ title: "Home", href: "/", eyebrow: "Portfolio" }}
  nextCase={{ title: "Run My Day", href: "/run-my-day", eyebrow: "Salesforce" }}
    images={[
      "/images/fsc-hero.png",  // hero (16:9 crop)
      "/images/fsc-section-1.gif",  // section 1 (3:2 crop)
      "/images/fsc-section-2.png",  // section 2 (3:2 crop)
      "/images/fsc-section-3.png",  // section 3 (3:2 crop)
      "/images/fsc-gallery-wide.png",  // gallery wide (16:9 crop)
      "/images/fsc-gallery-detail.png",  // gallery detail (full height)
    ]}
/>
