---
import CaseStudy from "../components/CaseStudy.astro";
const summary = "Wealth advisors like Sarah manage 87 client relationships and a $700M book — and the existing FSC home page gave them nothing to work with. No prioritization. No signal aggregation. No ambient awareness of which clients needed attention. Run My Day was designed to be the trusted chief of staff: a system that surfaces the right client, with the right signal, at the right moment — without requiring advisors to configure or query anything. It had to feel like intelligence, not infrastructure.";
const bullets = [
  "Four engagement groups (Retain, Grow, Service, Comply) with 12+ signal types organized by urgency and business impact, surfaced every morning without manual configuration",
  "Composite Score ranking algorithm — Card Importance Weight x Highest Row Score — ensures the highest-priority client always appears at the top of the advisor's triage queue",
  "Einstein AI draft outreach built into the workflow — the agent generates, Sarah reviews and sends; copy-paste, not auto-send",
  "Zero-configuration for advisors; full admin control via a 3-step setup wizard (Define, Configure, Activate) that deploys the system across an entire firm",
];
const sections = [
  { heading: "Arrive. Orient. Triage. Act. Return.", body: "Run My Day was designed around five phases of the advisor's morning — not as a UX framework for documentation, but as a structural constraint on every design decision. Every component, every state, every micro-copy choice was evaluated against the question: which phase does this serve, and is it helping the advisor move forward or slowing them down?" },
  { heading: "The Indicator Cascade: urgency flows upward, not downward.", body: "A signal at the row level sets the urgency of the insight card above it, which sets the urgency of the group header above that — and the system re-evaluates on every action taken. Urgency is not a badge on an icon; it is a full visual language applied consistently from the most granular signal to the most prominent group header. When Sarah dismisses a signal, the indicators recalculate in real time." },
  { heading: "You're in good shape today. is a first-class design deliverable.", body: "When Sarah has addressed every signal across her book, Run My Day does not show an empty screen — it shows an intentional completion state with a message designed to feel like a cleared inbox. The all-clear state is the emotional payoff for using the system well, and it was designed with the same rigor as any other state in the product. It is not a fallback. It is the reward." },
];
const takeaways = [
  "Ambient indicators over forced navigation: urgency should always be visible, but never coercive. The advisor knows what needs attention without being pushed into a workflow they did not choose.",
  "Zero-config for advisors means all configuration happens at the admin level. The person who uses the system should never have to set it up. Admin and advisor are different products with different surfaces.",
  "AI drafts as copy-paste, not send. Einstein generates the outreach; the advisor reviews and decides. That decision point is not optional — it is the human-in-the-loop architecture that makes the automation trustworthy.",
  "Comply as a structural constraint, not a modal. Regulatory signals cannot be snoozed or dismissed — they persist and log. Governance is embedded in the interaction model from the first frame, not added as a guardrail at the end.",
];
---
<CaseStudy
  title="Run My Day"
  eyebrow="Salesforce · Agentforce"
  role="Senior Product Designer"
  year="2023–2025"
  summary={summary}
  bullets={bullets}
  sections={sections}
  takeaways={takeaways}
  imageStart={13}
  prevCase={{ title: "FSC Agentic Experience", href: "/fsc", eyebrow: "Salesforce" }}
  nextCase={{ title: "Meeting 360", href: "/meeting-360", eyebrow: "Salesforce" }}
/>
