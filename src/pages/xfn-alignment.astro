---
import CaseStudy from "../components/CaseStudy.astro";
const summary = "Shipping 56 features across a four-product agentic system at Salesforce FSC required more than good design. It required a cross-functional operating model — one that could hold together research, product management, engineering, sales, and design leadership across two years and multiple release cycles, while keeping the product vision coherent and the customer pilots moving. XFN Alignment documents how that operating model was built, and what it made possible.";
const bullets = [
  "56 features shipped across 4 products and multiple release cycles — sustained by a cross-functional alignment model built from the first quarter of the project",
  "11 active customer pilot programs coordinated across sales, customer success, design, and product — with research synthesis feeding directly into release prioritization",
  "Future of Advising framework co-created with research, strategy, and product leadership — establishing the shared vision that held the four-product system together across two years",
  "100% adoption desire among pilot interviewees — a direct outcome of the customer-in-the-loop design process that embedded advisor feedback at every stage of the release cycle",
];
const sections = [
  { heading: "The Future of Advising framework was designed before the first feature was.", body: "Before any product work began, a multi-month alignment process brought together research, strategy, product management, and design leadership to define what the future of wealth advising should look like — and what Salesforce FSC's role in that future should be. The resulting framework was not a vision deck. It was the organizing principle for every product decision that followed: a shared vocabulary, a shared persona model, and a shared definition of what 'done' looked like at the system level." },
  { heading: "Research synthesis as a product input, not a research output.", body: "The customer pilot program was designed to feed directly into release prioritization — not as a post-hoc validation step, but as a standing input to the product process. Interview synthesis sessions ran across design, product management, and engineering every release cycle. Advisor feedback on one release shaped the scope of the next. The result was a product process where the customer's experience was a live signal, not a retrospective data point." },
  { heading: "Alignment at scale requires designed communication, not just good intentions.", body: "With stakeholders across design, product, engineering, sales, customer success, and executive leadership, the communication infrastructure had to be designed as deliberately as the product. That meant structured alignment sessions at each release milestone, a shared design system for communicating product decisions, and a deliberate practice of making design rationale visible — so that cross-functional partners could engage with the 'why' behind decisions, not just the 'what'." },
];
const takeaways = [
  "Vision alignment before feature work is the highest-leverage investment in a multi-product program. The Future of Advising framework reduced the cost of every subsequent alignment conversation because the foundational questions had already been answered.",
  "Cross-functional alignment is a design discipline. The tools — frameworks, communication structures, synthesis methods, shared vocabularies — are as designable as any product surface. Treating them as improvised coordination rather than designed infrastructure is how programs lose coherence at scale.",
  "Customer pilots are a design input, not a launch strategy. The 11 active pilots were most valuable not for the validation they provided at launch, but for the prioritization signal they generated throughout the development process. Real advisor feedback at every release cycle is a different product than one validated only at the end.",
  "The measure of cross-functional alignment is what gets shipped without a meeting. By the end of the program, design decisions that would have required a two-week alignment process in the first year could be resolved by the immediate team in an afternoon. That velocity is the ROI of the alignment investment.",
];
---
<CaseStudy
  title="XFN Alignment"
  eyebrow="Salesforce · FSC"
  role="Senior Product Designer"
  year="2023–2025"
  summary={summary}
  bullets={bullets}
  sections={sections}
  takeaways={takeaways}
  imageStart={55}
  prevCase={{ title: "Systems Design", href: "/systems-design", eyebrow: "Salesforce" }}
  nextCase={{ title: "Wealth Agents", href: "/wealth-agents", eyebrow: "Salesforce" }}
/>
