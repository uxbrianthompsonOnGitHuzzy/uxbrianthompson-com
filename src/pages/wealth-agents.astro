---
import CaseStudy from "../components/CaseStudy.astro";
const summary = "The Agentforce Wealth Agent brought conversational AI into the heart of the FSC advisor workspace — not as a chatbot sidebar, but as a first-class surface for querying client data, drafting communications, and taking actions directly from a natural language interface. The design challenge was building trust in an AI system operating in a high-stakes, regulated domain: every response had to be grounded, every action had to be reversible, and every interaction had to make the advisor more confident, not less.";
const bullets = [
  "Conversational AI panel integrated directly into the FSC workspace — advisors query client data, draft emails, and initiate actions through natural language without leaving their workflow",
  "Grounded on structured firm knowledge via RAG architecture — responses are anchored to FSC data, firm documents, and custodial records, not general-purpose model outputs",
  "Trust-first interaction design: every AI response includes its data source, every suggested action requires advisor confirmation, and every uncertainty is surfaced rather than hidden",
  "Prompt strategy library designed for the wealth advisory context — pre-built prompts for common advisor tasks, editable before submission, with response schemas optimized for financial data presentation",
];
const sections = [
  { heading: "The agent panel as a workspace tool, not a support chatbot.", body: "The Wealth Agent was designed to live inside the advisor's active workspace — not in a help sidebar, not in a separate tab. Its proximity to the client record, the signal panel, and the action layer means it can answer questions about a specific client, draft a communication based on their current context, or initiate a workflow — all without a context switch. Placement is design." },
  { heading: "Grounded generation means the agent only says what it knows.", body: "Every response from the Wealth Agent is grounded on data the system can verify — FSC client records, custodial data from BridgeFT, firm knowledge documents, and regulatory guidance. When the agent cites a portfolio figure or references a client interaction, that citation is traceable. When a question falls outside the grounding boundary, the agent says so. Confidence in what the system does not know is as important as accuracy in what it does." },
  { heading: "Trust emerges from legibility, not persuasion.", body: "The interaction model for the Wealth Agent was built around a single principle: the advisor should always understand why the agent said what it said. Every response surfaces its data source. Every suggested action includes the rationale. Every draft communication is labeled as AI-generated and editable before sending. The agent never acts; it proposes. The advisor never accepts blindly; they decide with full context." },
];
const takeaways = [
  "AI systems in regulated domains should be understandable before they are powerful. An agent that produces accurate outputs but opaque reasoning is not trustworthy — it is a liability. Legibility is the design requirement, not a nice-to-have.",
  "Grounding architecture is a design input, not a backend detail. The decision to ground the Wealth Agent on structured FSC data rather than general model knowledge changed every interaction pattern — what the agent could say, how it cited sources, and how it handled uncertainty.",
  "Prompt strategies designed for the domain outperform general-purpose prompting. The advisor-specific prompt library was not a convenience feature — it was the design of the agent's vocabulary. Advisors who used the pre-built prompts produced better outputs with less iteration.",
  "The confirmation step before every action is the human-in-the-loop architecture made visible. It is not friction — it is the feature that makes the system trustworthy enough to use in a regulated, client-facing context.",
];
---
<CaseStudy
  title="Wealth Agents"
  eyebrow="Salesforce"
  role="Senior Product Designer"
  year="2024–2025"
  summary={summary}
  bullets={bullets}
  sections={sections}
  takeaways={takeaways}
  imageStart={43}
  prevCase={{ title: "Integration Hub", href: "/integration-hub", eyebrow: "Salesforce FSC" }}
  nextCase={{ title: "Systems Design", href: "/systems-design", eyebrow: "Salesforce FSC" }}
/>
