---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Resume — Brian Thompson, Senior Product Designer"
  description="Brian Thompson's professional resume: Senior Product Designer specializing in Human–AI systems, agentic workflows, and decision intelligence. Salesforce, BofA, Google, Apple, Audi."
>

<style>
  /* ── Band system ─────────────────────────────────────────────── */
  .r-band { width: 100%; }
  .r-band--white { background: var(--cream); }
  .r-band--linen { background: var(--soft-linen); }

  .r-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 48px;
  }
  .r-inner--top { padding-top: 120px; }
  .r-inner--bottom { padding-bottom: 120px; }

  /* ── Header ─────────────────────────────────────────────────── */
  .r-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 64px;
    flex-wrap: wrap;
  }
  .r-name {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    color: var(--dark-warm);
    margin: 0 0 6px;
    line-height: 1;
  }
  .r-title-line {
    font-size: 0.9rem;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    margin: 0 0 3px;
  }
  .r-subtitle-line {
    font-size: 0.82rem;
    color: var(--silver);
    font-family: 'Inter', sans-serif;
    margin: 0 0 14px;
  }
  .r-contact {
    font-size: 0.82rem;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0;
  }
  .r-contact a {
    color: var(--dim-grey);
    text-decoration: none;
    transition: color 0.18s;
  }
  .r-contact a:hover { color: var(--dark-warm); }
  .r-pdf-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dark-warm);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.18s;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--dark-warm);
  }
  .r-pdf-link:hover { opacity: 0.6; }

  /* ── Section labels ──────────────────────────────────────────── */
  .r-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--silver);
    margin: 0 0 28px;
  }
  .r-sublabel {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--silver);
    margin: 56px 0 20px;
  }

  /* ── Body text ──────────────────────────────────────────────── */
  .r-body {
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0 0 10px;
  }
  .r-body:last-child { margin: 0; }

  /* ── Bullets ────────────────────────────────────────────────── */
  .r-bullet {
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0 0 6px;
    padding-left: 18px;
    position: relative;
  }
  .r-bullet::before {
    content: '·';
    position: absolute;
    left: 4px;
    color: var(--silver);
  }
  .r-bullet:last-child { margin-bottom: 0; }

  /* ── Two-column bullet grid ──────────────────────────────────── */
  .r-grid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  /* ── Employer: logo-left + all-text-right ────────────────────── */
  .employer {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 0 32px;
    padding: 40px 0;
    border-top: 1px solid rgba(104,103,99,0.15);
  }
  .employer:first-of-type { border-top: none; padding-top: 0; }

  .employer-logo {
    padding-top: 3px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }
  .employer-logo img {
    max-width: 60px;
    max-height: 44px;
    width: auto;
    height: auto;
    opacity: 0.75;
    display: block;
  }

  .employer-headline {
    font-size: 0.92rem;
    font-family: 'Inter', sans-serif;
    color: var(--dim-grey);
    margin: 0 0 10px;
    line-height: 1.5;
  }
  .employer-co {
    font-weight: 700;
    color: var(--dark-warm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* ── Impact grid (no card wrapper — mirrors expertise) ───────── */
  .r-impact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 20px;
  }

  /* ── Education + Tools side by side ─────────────────────────── */
  .r-edu-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 80px;
    align-items: start;
  }

  /* ── Tools tags ─────────────────────────────────────────────── */
  .r-tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .r-tool-tag {
    font-size: 12px;
    font-family: 'Inter', sans-serif;
    color: var(--dim-grey);
    background: var(--cream);
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--silver);
    white-space: nowrap;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .r-inner           { padding: 64px 24px; }
    .r-inner--top      { padding-top: 96px; }
    .r-inner--bottom   { padding-bottom: 96px; }
    .r-header          { flex-direction: column; align-items: flex-start; gap: 24px; }
    .r-grid-2col       { grid-template-columns: 1fr; }
    .r-impact-grid     { grid-template-columns: 1fr; }
    .r-edu-tools       { grid-template-columns: 1fr; gap: 48px 0; }
    .employer          { grid-template-columns: 52px 1fr; gap: 0 20px; }
    .employer-logo img { max-width: 44px; max-height: 32px; }
  }
</style>

<Nav />

<!-- ════════════════════════════════════════════════════════════ -->
<!--  BAND 1 — WHITE — Header · Summary · Core Expertise         -->
<!-- ════════════════════════════════════════════════════════════ -->
<section class="r-band r-band--white">
  <div class="r-inner r-inner--top">

    <header class="r-header">
      <div>
        <h1 class="r-name font-display">Brian Thompson</h1>
        <p class="r-title-line">Senior Product Designer</p>
        <p class="r-subtitle-line">Human–AI Systems · Agentic Workflows · Decision Intelligence</p>
        <p class="r-contact">
          <a href="mailto:uxbrianthompson@gmail.com">uxbrianthompson@gmail.com</a>
          &nbsp;·&nbsp;
          <a href="https://linkedin.com/in/uxbrianthompson" target="_blank" rel="noopener">
            linkedin.com/in/uxbrianthompson
          </a>
        </p>
      </div>
      <a href="/Brian-Thompson-Resume.pdf" download class="r-pdf-link">» Download PDF</a>
    </header>

    <!-- Summary -->
    <p class="r-label">Summary</p>
    <p class="r-body">
      Product Designer specializing in AI-native product design, with a focus on how intelligent
      systems shape human reasoning, decision-making, and real-world outcomes.
    </p>
    <p class="r-body">
      I design agentic and conversational AI systems that integrate foundation models, retrieval
      systems, and structured data into workflows where model outputs directly influence user
      behavior. My work emphasizes making AI systems interpretable, steerable, and trustworthy —
      particularly in complex, high-stakes domains like financial services.
    </p>
    <p class="r-body" style="margin-bottom:64px;">
      I bring a systems-level approach that connects model behavior, interaction design, and human
      cognition — partnering closely with product, engineering, and research to translate emerging
      AI capabilities into usable, responsible products.
    </p>

    <!-- Core Expertise -->
    <p class="r-label">Core Expertise</p>
    <div class="r-grid-2col">
      {[
        "AI Product Design — foundation models, agentic systems, retrieval",
        "Human–AI Interaction & Collaboration Design",
        "Conversational & Multimodal UX",
        "Interpretability, Trust, and AI Transparency",
        "Decision System Design — high-stakes workflows",
        "Systems Thinking & Experience Architecture",
        "Rapid Prototyping — high-fidelity, interaction-rich",
        "Cross-functional product strategy in ambiguous environments",
      ].map(item => (
        <p class="r-bullet">{item}</p>
      ))}
    </div>

  </div>
</section>

<!-- ════════════════════════════════════════════════════════════ -->
<!--  BAND 2 — LINEN — Salesforce · Impact · Selected Work · Philosophy -->
<!-- ════════════════════════════════════════════════════════════ -->
<section class="r-band r-band--linen">
  <div class="r-inner">

    <p class="r-label">Professional Experience</p>

    <!-- Salesforce FSC -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-salesforce.svg" alt="Salesforce" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Salesforce</span>, Financial Services Cloud &nbsp;·&nbsp; Senior Product Designer, AI Experiences &nbsp;·&nbsp; 2023 – Present
        </p>
        <p class="r-body">
          Leading design of AI-assisted decision systems for financial advisors, bankers, and
          clients in complex, high-stakes workflows.
        </p>
        {[
          "Designed and launched agentic AI systems synthesizing structured data, foundation model outputs, and retrieval pipelines into actionable insights and next-best actions",
          "Defined interaction models for human–AI collaboration — inspection, refinement, and validation of AI-generated outputs",
          "Designed conversational and panel-based AI interfaces supporting recommendations, explainability, citations, and follow-on actions",
          "Partnered with Product, Engineering, and Data Science to align UX with model behavior, latency constraints, and system limitations",
          "Developed context engineering strategies, response schemas, and feedback loops — evaluation signals, user corrections, iterative refinement",
          "Drove systems-level UX across proactive AI guidance surfaces, alerts, and monitoring systems",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Impact -->
    <p class="r-sublabel">Impact</p>
    <div class="r-impact-grid">
      {[
        "56+ features shipped, including 17 zero-to-one AI capabilities",
        "32 agentic insights and action systems deployed across FSC surfaces",
        "11 active enterprise pilot programs — Schwab, BofA/Merrill, TIAA, Northern Trust",
        "Owned design from discovery to deployment across 8 FSC product surfaces",
        "Led 40+ cross-functional alignment sessions spanning Product, Engineering, Data Science, Legal, and Compliance",
        "Delivered 200+ design artifacts across agentic, conversational, and proactive AI patterns",
      ].map(b => <p class="r-bullet">{b}</p>)}
    </div>

    <!-- Selected AI & Systems Design Work -->
    <p class="r-sublabel">Selected AI &amp; Systems Design Work</p>
    {[
      "Run My Day — AI-driven daily briefing system synthesizing CRM data, calendar events, alerts, and market signals into a personalized advisor agenda with surfaced actions",
      "Meeting 360 — Pre-meeting intelligence system aggregating client portfolio status, relationship history, open items, and AI-generated talking points in a single panel",
      "Performance Analytics — Agentic analytics surface that detects anomalies, surfaces trends, and generates next-best actions across an advisor's full book of business",
      "Advisor Anywhere — Mobile-first decision support giving advisors AI-curated client context, recommendations, and direct action capability away from their primary workspace",
      "Integration Hub — Orchestration interface connecting external custodians, market data, and internal CRM to power real-time AI features across the FSC platform",
      "Wealth Agents — Autonomous agentic workflow system enabling advisors to delegate complex, multi-step tasks to AI with full visibility, control, and auditability",
    ].map(b => <p class="r-bullet">{b}</p>)}

    <!-- Design Philosophy -->
    <p class="r-sublabel">Design Philosophy</p>
    {[
      "AI systems should be understandable before they are powerful",
      "Trust emerges from legibility, not persuasion",
      "Designing for AI requires shaping systems and behaviors, not just interfaces",
      "The goal is not automation, but better human judgment",
    ].map(p => <p class="r-bullet">{p}</p>)}

  </div>
</section>

<!-- ════════════════════════════════════════════════════════════ -->
<!--  BAND 3 — WHITE — Education · Tools                          -->
<!-- ════════════════════════════════════════════════════════════ -->
<section class="r-band r-band--white">
  <div class="r-inner">
    <div class="r-edu-tools">

      <!-- Education -->
      <div>
        <p class="r-label">Education</p>
        <div class="r-grid-2col">
          {[
            "Agentblazer Certification — Salesforce Trailhead",
            "Mobile UX Design Certificate — UC San Francisco, CA",
            "TrailBlazer Certification — Salesforce Trailhead",
            "Art direction, design, and writing — Creative Circus, Atlanta, GA",
            "UX/UI Design Boot Camp Certificate — UC Berkeley, CA",
            "Studied Japanese and taught English — Tokyo, JP",
            "Google Foundations of UX Design Certificate",
            "Journalism with advertising emphasis — University of Minnesota",
            "Wearable and Smart Device UX Design Certificate — SCU, CA",
            "",
          ].map(e => e ? <p class="r-bullet">{e}</p> : <p></p>)}
        </div>
      </div>

      <!-- Tools & Methods -->
      <div>
        <p class="r-label">Tools &amp; Methods</p>
        <div class="r-tools-list">
          {[
            "Figma — advanced prototyping",
            "Prompt design",
            "Conversational flow design",
            "Agent behavior design",
            "AI interaction modeling",
            "Systems mapping",
            "Research synthesis",
            "Rapid validation",
            "Context engineering",
          ].map(t => <span class="r-tool-tag">{t}</span>)}
        </div>
        <p class="r-body" style="margin-top:28px; font-style:italic; color:var(--silver); font-size:0.88rem;">
          A whiteboard, markers, a No.&nbsp;2 pencil with eraser, and my mind.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════ -->
<!--  BAND 4 — LINEN — Additional Experience                      -->
<!-- ════════════════════════════════════════════════════════════ -->
<section class="r-band r-band--linen">
  <div class="r-inner r-inner--bottom">

    <p class="r-label">Additional Experience</p>

    <!-- Bank of America -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-bofa.svg" alt="Bank of America" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Bank of America</span> &nbsp;·&nbsp; Sr. Product Designer &nbsp;·&nbsp; 2022 – 2023
        </p>
        <p class="r-body">
          Led 0→1 design for AI-integrated banking experiences — how AI augments financial
          decision-making at scale.
        </p>
        {[
          "Designed AI-assisted experiences integrating Erica across global banking platforms",
          "Built interaction models connecting user intent, financial context, and AI-generated outputs",
          "Defined user journeys grounded in behavioral and cognitive patterns in financial decision-making",
          "Prototyped and tested AI recommendation systems, validation loops, and user feedback mechanisms",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Google -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-google.svg" alt="Google" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Google</span> &nbsp;·&nbsp; Sr. Experience Designer, contract &nbsp;·&nbsp; 2022
        </p>
        <p class="r-body">
          Designed decision-support flows for global hardware launches — Pixel 7a, Pixel Fold,
          Pixel Tablet.
        </p>
        {[
          "Structured complex product information to support decision-making under uncertainty",
          "Designed buy-flows that help users evaluate tradeoffs, configurations, and constraints",
          "Contributed to globally consistent experiences across 18+ markets",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Crunchyroll -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-crunchyroll.svg" alt="Crunchyroll" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Crunchyroll</span> &nbsp;·&nbsp; Design Director &nbsp;·&nbsp; 2020 – 2022
        </p>
        <p class="r-body">
          Led UX across large-scale consumer platforms, shaping systems that influence user
          behavior at scale.
        </p>
        {[
          "Directed experience design across streaming, commerce, and community ecosystems",
          "Designed FunimationCon — first-ever virtual anime convention, 63k+ attendees, 331k+ engagement hours",
          "Led subscriber growth from 3M to 5M paid subscribers",
          "Built and scaled teams, systems, and design infrastructure across the organization",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Salesforce agency -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-salesforce.svg" alt="Salesforce" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Salesforce</span> &nbsp;·&nbsp; Group Creative Director, via agency &nbsp;·&nbsp; 2016 – 2018
        </p>
        <p class="r-body">
          Led strategy, UX, and brand design for the Salesforce Customer 360° and Trailblazer
          Journey at Dreamforce.
        </p>
        {[
          "Connected 170k on-site attendees across 17 San Francisco locations and 10M+ online participants",
          "Designed the AI-guided super agenda builder — personalized by role, cloud, and goals",
          "Drove 163M social impressions and all-time high organic leads during the event window",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Circusfreaks -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-circusfreaks.svg" alt="Circusfreaks" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Circusfreaks</span> &nbsp;·&nbsp; Creative Director &amp; Co-founder
        </p>
        <p class="r-body">
          Co-founded and led creative direction for an independent digital studio, building
          award-winning interactive experiences for enterprise clients.
        </p>
      </div>
    </div>

    <!-- Apple -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-apple.svg" alt="Apple" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Apple</span> &nbsp;·&nbsp; Associate Creative Director, via agency &nbsp;·&nbsp; 2014 – 2015
        </p>
        <p class="r-body">
          Led the Apple Watch launch and iPhone release across multiple channels.
        </p>
        {[
          "Defined and conceptualized in-store interactive and direct marketing experiences",
          "36MM units sold during the launch window (cited by CNET)",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Audi -->
    <div class="employer">
      <div class="employer-logo">
        <img src="/images/logos/logo-audi.svg" alt="Audi" />
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Audi</span> &nbsp;·&nbsp; Associate Creative Director, via agency &nbsp;·&nbsp; 2013 – 2014
        </p>
        <p class="r-body">
          Led UX and brand design for the FWA Award-winning AudiUSA.com redesign and myAudi
          platform.
        </p>
        {[
          "227% increase in car configurations · 675% increase in myAudi interactions",
          "2,763% increase in financing page visits · directly trackable sales at all-time high",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

  </div>
</section>

<Footer />

</BaseLayout>
