---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Resume — Brian Thompson, Senior Product Designer"
  description="Brian Thompson's professional resume: Senior Product Designer specializing in Human–AI systems, agentic workflows, and decision intelligence. Salesforce, BofA, Google, Apple, Audi."
>

<style>
  /* ── Page shell ─────────────────────────────────────────────── */
  .resume-page {
    padding: 120px 48px 160px;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .r-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--silver);
    flex-wrap: wrap;
  }
  .r-name {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    color: var(--dark-warm);
    margin: 0 0 6px;
    line-height: 1;
  }
  .r-title-line {
    font-size: 0.9rem;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    margin: 0 0 3px;
  }
  .r-subtitle-line {
    font-size: 0.82rem;
    color: var(--silver);
    font-family: 'Inter', sans-serif;
    margin: 0 0 14px;
  }
  .r-contact {
    font-size: 0.82rem;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0;
  }
  .r-contact a {
    color: var(--dim-grey);
    text-decoration: none;
    transition: color 0.18s;
  }
  .r-contact a:hover { color: var(--dark-warm); }

  .r-pdf-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dark-warm);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.18s;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--dark-warm);
  }
  .r-pdf-link:hover { opacity: 0.6; }

  /* ── Section wrapper ─────────────────────────────────────────── */
  .r-section {
    padding: 52px 0;
    border-bottom: 1px solid var(--silver);
  }
  .r-section:last-child { border-bottom: none; }

  /* ── Section label ───────────────────────────────────────────── */
  .r-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--silver);
    margin: 0 0 28px;
  }

  /* ── Body text / bullets ─────────────────────────────────────── */
  .r-body {
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0 0 10px;
  }
  .r-body:last-child { margin: 0; }

  .r-bullet {
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0 0 6px;
    padding-left: 18px;
    position: relative;
  }
  .r-bullet::before {
    content: '·';
    position: absolute;
    left: 4px;
    color: var(--silver);
  }
  .r-bullet:last-child { margin-bottom: 0; }

  /* ── Employer: logo-left + all-text-right ────────────────────── */
  .employer {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 0 32px;
    padding: 40px 0;
    border-top: 1px solid rgba(104,103,99,0.15);
  }
  .employer:first-child { border-top: none; padding-top: 0; }

  /* Logo column */
  .employer-logo {
    padding-top: 3px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .employer-logo svg,
  .employer-logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    opacity: 0.75;
  }

  /* Text column — everything flows here */
  .employer-body {}

  /* First line: COMPANY NAME, role, year — all inline */
  .employer-headline {
    font-size: 0.92rem;
    font-family: 'Inter', sans-serif;
    color: var(--dim-grey);
    margin: 0 0 10px;
    line-height: 1.5;
  }
  .employer-co {
    font-weight: 700;
    color: var(--dark-warm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Impact block */
  .impact-block {
    margin: 20px 0 0;
    padding: 20px 24px;
    background: var(--soft-linen);
    border-radius: 10px;
  }
  .impact-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--silver);
    margin: 0 0 14px;
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .impact-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--dark-warm);
    margin: 0 0 4px;
    line-height: 1;
  }
  .impact-desc {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--dim-grey);
    font-family: 'Inter', sans-serif;
    margin: 0;
  }

  /* ── Expertise grid ──────────────────────────────────────────── */
  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .resume-page     { padding: 80px 24px 100px; }
    .employer        { grid-template-columns: 52px 1fr; gap: 0 20px; }
    .employer-logo svg,
    .employer-logo img { width: 36px; height: 36px; }
    .expertise-grid  { grid-template-columns: 1fr; }
    .impact-grid     { grid-template-columns: 1fr 1fr; }
    .r-header        { flex-direction: column; align-items: flex-start; gap: 24px; }
  }
</style>

<!-- Logo SVGs as reusable snippets -->
<!-- Salesforce cloud -->
<svg style="display:none">
  <symbol id="logo-salesforce" viewBox="0 0 100 67">
    <path d="M41.6 7.7C45.2 3.5 50.5 1 56.4 1c8 0 14.9 4.6 18.4 11.3C77.8 10.5 81.6 9.5 85.6 9.5c12.4 0 22.4 10.1 22.4 22.6 0 12.5-10 22.6-22.4 22.6-.8 0-1.7-.1-2.5-.2-3.1 5.6-9 9.4-15.7 9.4-2.7 0-5.2-.6-7.5-1.8-3.2 6.9-10.2 11.7-18.3 11.7-7.7 0-14.5-4.3-18-10.8-1.3.3-2.7.4-4.1.4C8.9 63.4 1 55.4 1 45.7c0-6.3 3.3-11.9 8.3-15.1-1-2.3-1.5-4.8-1.5-7.5C7.8 12.9 16.3 4.5 26.8 4.5c5.5 0 10.5 2.2 14.1 5.8z" fill="currentColor"/>
  </symbol>
</svg>

<div class="resume-page">

  <!-- ── Header ──────────────────────────────────────────────── -->
  <header class="r-header">
    <div>
      <h1 class="r-name font-display">Brian Thompson</h1>
      <p class="r-title-line">Senior Product Designer</p>
      <p class="r-subtitle-line">Human–AI Systems · Agentic Workflows · Decision Intelligence</p>
      <p class="r-contact">
        <a href="mailto:uxbrianthompson@gmail.com">uxbrianthompson@gmail.com</a>
        &nbsp;·&nbsp;
        <a href="https://linkedin.com/in/uxbrianthompson" target="_blank" rel="noopener">
          linkedin.com/in/uxbrianthompson
        </a>
      </p>
    </div>
    <a href="/Brian-Thompson-Resume.pdf" download class="r-pdf-link">» Download PDF</a>
  </header>

  <!-- ── Summary ─────────────────────────────────────────────── -->
  <section class="r-section">
    <p class="r-label">Summary</p>
    <p class="r-body">
      Product Designer specializing in AI-native product design, with a focus on how intelligent
      systems shape human reasoning, decision-making, and real-world outcomes.
    </p>
    <p class="r-body">
      I design agentic and conversational AI systems that integrate foundation models, retrieval
      systems, and structured data into workflows where model outputs directly influence user
      behavior. My work emphasizes making AI systems interpretable, steerable, and trustworthy —
      particularly in complex, high-stakes domains like financial services.
    </p>
    <p class="r-body">
      I bring a systems-level approach that connects model behavior, interaction design, and human
      cognition — partnering closely with product, engineering, and research to translate emerging
      AI capabilities into usable, responsible products.
    </p>
  </section>

  <!-- ── Core Expertise ──────────────────────────────────────── -->
  <section class="r-section">
    <p class="r-label">Core Expertise</p>
    <div class="expertise-grid">
      {[
        "AI Product Design — foundation models, agentic systems, retrieval",
        "Human–AI Interaction & Collaboration Design",
        "Conversational & Multimodal UX",
        "Interpretability, Trust, and AI Transparency",
        "Decision System Design — high-stakes workflows",
        "Systems Thinking & Experience Architecture",
        "Rapid Prototyping — high-fidelity, interaction-rich",
        "Cross-functional product strategy in ambiguous environments",
      ].map(item => (
        <p class="r-bullet">{item}</p>
      ))}
    </div>
  </section>

  <!-- ── Professional Experience ─────────────────────────────── -->
  <section class="r-section">
    <p class="r-label">Professional Experience</p>

    <!-- Salesforce FSC -->
    <div class="employer">
      <div class="employer-logo">
        <!-- Salesforce cloud mark -->
        <svg viewBox="0 0 56 40" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:48px;height:48px;opacity:0.7;">
          <path d="M23.2 4.3C25.2 2 28.3.6 31.6.6c4.5 0 8.4 2.6 10.3 6.3 1.6-.9 3.5-1.4 5.5-1.4C54 5.5 59 10.6 59 16.9S54 28.3 47.4 28.3c-.5 0-.9 0-1.4-.1-1.7 3.1-5 5.2-8.8 5.2-1.5 0-2.9-.4-4.2-1-1.8 3.9-5.7 6.6-10.3 6.6-4.3 0-8.1-2.4-10.1-6-1 .2-1.5.2-2.3.2C4.7 33.2.3 28.7.3 23.2c0-3.5 1.8-6.7 4.6-8.5-.6-1.3-.8-2.7-.8-4.2C4.1 5 8.8.4 14.5.4c2.7 0 5.3 1 7.2 2.8" fill="currentColor"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Salesforce</span>, Financial Services Cloud, Senior Product Designer, AI Experiences, 2023 – Present
        </p>
        <p class="r-body">
          Leading design of AI-assisted decision systems for financial advisors, bankers, and
          clients in complex, high-stakes workflows.
        </p>
        {[
          "Designed and launched agentic AI systems synthesizing structured data, foundation model outputs, and retrieval pipelines into actionable insights and next-best actions",
          "Defined interaction models for human–AI collaboration — inspection, refinement, and validation of AI-generated outputs",
          "Designed conversational and panel-based AI interfaces supporting recommendations, explainability, citations, and follow-on actions",
          "Partnered with Product, Engineering, and Data Science to align UX with model behavior, latency constraints, and system limitations",
          "Developed context engineering strategies, response schemas, and feedback loops — evaluation signals, user corrections, iterative refinement",
          "Drove systems-level UX across proactive AI guidance surfaces, alerts, and monitoring systems",
        ].map(b => <p class="r-bullet">{b}</p>)}
        <div class="impact-block">
          <p class="impact-label">Impact</p>
          <div class="impact-grid">
            {[
              ["56+", "features shipped, including 17 zero-to-one AI capabilities"],
              ["32",  "agentic insights and action systems deployed"],
              ["11",  "active pilot programs with Schwab, BofA/Merrill, TIAA, Northern Trust"],
            ].map(([n, label]) => (
              <div>
                <p class="impact-num">{n}</p>
                <p class="impact-desc">{label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Bank of America -->
    <div class="employer">
      <div class="employer-logo">
        <!-- BofA flag mark -->
        <svg viewBox="0 0 48 48" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="width:48px;height:48px;opacity:0.7;">
          <rect x="4" y="8"  width="40" height="6" rx="1"/>
          <rect x="4" y="18" width="40" height="6" rx="1"/>
          <rect x="4" y="28" width="40" height="6" rx="1"/>
          <rect x="4" y="38" width="40" height="4" rx="1"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Bank of America</span>, Sr. Product Designer, 2022 – 2023
        </p>
        <p class="r-body">
          Led 0→1 design for AI-integrated banking experiences — how AI augments financial
          decision-making at scale.
        </p>
        {[
          "Designed AI-assisted experiences integrating Erica across global banking platforms",
          "Built interaction models connecting user intent, financial context, and AI-generated outputs",
          "Defined user journeys grounded in behavioral and cognitive patterns in financial decision-making",
          "Prototyped and tested AI recommendation systems, validation loops, and user feedback mechanisms",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Google -->
    <div class="employer">
      <div class="employer-logo">
        <!-- Google G -->
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:48px;height:48px;opacity:0.7;">
          <path d="M44 24.5c0-1.4-.1-2.8-.4-4H24v7.6h11.3c-.5 2.6-2 4.8-4.1 6.3v5.2h6.6C41.5 35.8 44 30.5 44 24.5z" fill="#4285F4"/>
          <path d="M24 45c5.6 0 10.3-1.9 13.8-5l-6.6-5.2c-1.9 1.3-4.3 2-7.2 2-5.5 0-10.2-3.7-11.8-8.8H5.4v5.4C8.9 41.1 16 45 24 45z" fill="#34A853"/>
          <path d="M12.2 28c-.4-1.3-.7-2.6-.7-4s.3-2.7.7-4v-5.4H5.4C3.9 17.6 3 20.7 3 24s.9 6.4 2.4 9.4l6.8-5.4z" fill="#FBBC05"/>
          <path d="M24 11.2c3.1 0 5.9 1.1 8.1 3.2l6-6C34.3 4.9 29.5 3 24 3 16 3 8.9 6.9 5.4 14.6l6.8 5.4C13.8 14.9 18.5 11.2 24 11.2z" fill="#EA4335"/>
          <path d="M24 24.5h10v-4H24v4z" fill="#4285F4"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Google</span>, Sr. Experience Designer, contract, 2022
        </p>
        <p class="r-body">
          Designed decision-support flows for global hardware launches — Pixel 7a, Pixel Fold,
          Pixel Tablet.
        </p>
        {[
          "Structured complex product information to support decision-making under uncertainty",
          "Designed buy-flows that help users evaluate tradeoffs, configurations, and constraints",
          "Contributed to globally consistent experiences across 18+ markets",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Crunchyroll -->
    <div class="employer">
      <div class="employer-logo">
        <!-- Crunchyroll crescent -->
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:48px;height:48px;opacity:0.7;">
          <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="4"/>
          <circle cx="30" cy="24" r="13" fill="var(--parchment)"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Crunchyroll</span>, Design Director, 2020 – 2022
        </p>
        <p class="r-body">
          Led UX across large-scale consumer platforms, shaping systems that influence user
          behavior at scale.
        </p>
        {[
          "Directed experience design across streaming, commerce, and community ecosystems",
          "Designed FunimationCon — first-ever virtual anime convention, 63k+ attendees, 331k+ engagement hours",
          "Led subscriber growth from 3M to 5M paid subscribers",
          "Built and scaled teams, systems, and design infrastructure across the organization",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Salesforce agency -->
    <div class="employer">
      <div class="employer-logo">
        <svg viewBox="0 0 56 40" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:48px;height:48px;opacity:0.7;">
          <path d="M23.2 4.3C25.2 2 28.3.6 31.6.6c4.5 0 8.4 2.6 10.3 6.3 1.6-.9 3.5-1.4 5.5-1.4C54 5.5 59 10.6 59 16.9S54 28.3 47.4 28.3c-.5 0-.9 0-1.4-.1-1.7 3.1-5 5.2-8.8 5.2-1.5 0-2.9-.4-4.2-1-1.8 3.9-5.7 6.6-10.3 6.6-4.3 0-8.1-2.4-10.1-6-1 .2-1.5.2-2.3.2C4.7 33.2.3 28.7.3 23.2c0-3.5 1.8-6.7 4.6-8.5-.6-1.3-.8-2.7-.8-4.2C4.1 5 8.8.4 14.5.4c2.7 0 5.3 1 7.2 2.8" fill="currentColor"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Salesforce</span>, Group Creative Director, via agency, 2016 – 2018
        </p>
        <p class="r-body">
          Led strategy, UX, and brand design for the Salesforce Customer 360° and Trailblazer
          Journey at Dreamforce.
        </p>
        {[
          "Connected 170k on-site attendees across 17 San Francisco locations and 10M+ online participants",
          "Designed the AI-guided super agenda builder — personalized by role, cloud, and goals",
          "Drove 163M social impressions and all-time high organic leads during the event window",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Apple -->
    <div class="employer">
      <div class="employer-logo">
        <!-- Apple mark -->
        <svg viewBox="0 0 48 56" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="width:44px;height:48px;opacity:0.7;">
          <path d="M39.6 29.4c-.1-7 5.7-10.4 6-10.6-3.3-4.8-8.4-5.4-10.2-5.5-4.3-.4-8.4 2.5-10.6 2.5-2.2 0-5.5-2.5-9.1-2.4-4.6.1-8.9 2.7-11.3 6.8-4.9 8.4-1.2 20.8 3.4 27.6 2.3 3.3 5 7 8.6 6.9 3.5-.1 4.8-2.2 9-2.2s5.4 2.2 9 2.1c3.7-.1 6.1-3.3 8.4-6.7 2.7-3.8 3.8-7.5 3.8-7.7-.1 0-7-2.7-7.1-10.8zm-6.7-19.8c1.9-2.3 3.1-5.4 2.8-8.6-2.7.1-6 1.8-7.9 4.1-1.7 2-3.2 5.2-2.8 8.3 3 .2 6.1-1.5 7.9-3.8z"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Apple</span>, Associate Creative Director, via agency, 2014 – 2015
        </p>
        <p class="r-body">
          Led the Apple Watch launch and iPhone release across multiple channels.
        </p>
        {[
          "Defined and conceptualized in-store interactive and direct marketing experiences",
          "36MM units sold during the launch window (cited by CNET)",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

    <!-- Audi -->
    <div class="employer">
      <div class="employer-logo">
        <!-- Audi four rings -->
        <svg viewBox="0 0 72 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:52px;height:20px;opacity:0.7;">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="28" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="44" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="60" cy="12" r="10" stroke="currentColor" stroke-width="2.5"/>
        </svg>
      </div>
      <div class="employer-body">
        <p class="employer-headline">
          <span class="employer-co">Audi</span>, Associate Creative Director, via agency, 2013 – 2014
        </p>
        <p class="r-body">
          Led UX and brand design for the FWA Award-winning AudiUSA.com redesign and myAudi
          platform.
        </p>
        {[
          "227% increase in car configurations · 675% increase in myAudi interactions",
          "2,763% increase in financing page visits · directly trackable sales at all-time high",
        ].map(b => <p class="r-bullet">{b}</p>)}
      </div>
    </div>

  </section>

  <!-- ── Design Philosophy ────────────────────────────────────── -->
  <section class="r-section">
    <p class="r-label">Design Philosophy</p>
    {[
      "AI systems should be understandable before they are powerful",
      "Trust emerges from legibility, not persuasion",
      "Designing for AI requires shaping systems and behaviors, not just interfaces",
      "The goal is not automation, but better human judgment",
    ].map(p => <p class="r-bullet">{p}</p>)}
  </section>

  <!-- ── Tools & Methods ──────────────────────────────────────── -->
  <section class="r-section">
    <p class="r-label">Tools &amp; Methods</p>
    <p class="r-body">
      Figma (advanced prototyping) · Context engineering · Conversational flow design ·
      Rapid validation · Systems mapping · Research synthesis ·
      Agent behavior design · A whiteboard, markers, No.&nbsp;2 pencil with eraser, and my mind.
    </p>
  </section>

  <!-- ── Education ────────────────────────────────────────────── -->
  <section class="r-section">
    <p class="r-label">Education</p>
    {[
      "Agentblazer Certification — Salesforce Trailhead",
      "TrailBlazer Certification — Salesforce Trailhead",
      "UX/UI Design Boot Camp Certificate — UC Berkeley, CA",
      "Google Foundations of UX Design Certificate",
      "Wearable and Smart Device UX Design Certificate — SCU, CA",
      "Mobile UX Design Certificate — UC San Francisco, CA",
      "Art direction, design, and writing — Creative Circus, Atlanta, GA",
      "Studied Japanese and taught English — Tokyo, JP",
      "Journalism with advertising emphasis — University of Minnesota",
    ].map(e => <p class="r-bullet">{e}</p>)}
  </section>

</div>

</BaseLayout>
