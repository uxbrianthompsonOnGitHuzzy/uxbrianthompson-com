---
import Nav from "./Nav.astro";
import '../styles/global.css';

interface CaseSection { heading: string; body: string; }
interface PrevNext { title: string; href: string; eyebrow: string; }
interface Props {
  title: string;
  eyebrow: string;
  role: string;
  year: string;
  summary?: string;
  bullets?: string[];
  sections?: CaseSection[];
  takeaways?: string[];
  imageStart?: number;
  images?: string[];
  prevCase: PrevNext;
  nextCase: PrevNext;
}

const {
  title, eyebrow, role, year,
  summary = "",
  bullets = [],
  sections = [],
  takeaways = [],
  imageStart = 0,
  images,
  prevCase, nextCase,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Brian Thompson</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav />

  <!-- HERO ──────────────────────────────────────────────────── -->
  <section class="cs-hero">
    <p class="cs-eyebrow">{eyebrow}</p>
    <h1 class="font-display cs-title">{title}</h1>
    <div class="cs-meta">
      <div>
        <p class="cs-meta-label">Role</p>
        <p class="cs-meta-value">{role}</p>
      </div>
      <div>
        <p class="cs-meta-label">Year</p>
        <p class="cs-meta-value">{year}</p>
      </div>
    </div>
    {summary && (
      <p class="cs-summary">{summary}</p>
    )}
  </section>

  <!-- HERO IMAGE ─────────────────────────────────────────────── -->
  <div class="cs-hero-img-wrap">
    {images && images[0] ? (
      <div style="width:100%; aspect-ratio:16/9; overflow:hidden; border-radius:12px;">
        <img src={images[0]} class="lb"
             style="width:100%; height:100%; object-fit:cover; object-position:top left; display:block; cursor:zoom-in;" />
      </div>
    ) : (
      <div style="width:100%; aspect-ratio:16/9; background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;">
        <p style="font-size:13px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0; letter-spacing:0.04em;">{imageStart}. {title} — Case Study Hero</p>
        <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.14em; text-transform:uppercase;">Hero Image · Figma Export</p>
      </div>
    )}
  </div>

  <!-- IMPACT ─────────────────────────────────────────────────── -->
  {bullets.length > 0 && (
    <section class="cs-impact-section">
      <p class="cs-section-label">Impact</p>
      <ul class="cs-impact-grid">
        {bullets.map(b => (
          <li class="cs-impact-item">{b}</li>
        ))}
      </ul>
    </section>
  )}

  <!-- SECTION 1: image left, text right ──────────────────────── -->
  {sections.length > 0 && (
    <section class="cs-content-section">
      <div class="cs-two-col">
        {images && images[1] ? (
          <div class="cs-img-wrap">
            <img src={images[1]} class="lb"
                 style="width:100%; height:100%; object-fit:cover; object-position:top left; display:block; cursor:zoom-in;" />
          </div>
        ) : (
          <div class="lb cs-img-wrap cs-placeholder" style="cursor:zoom-in;">
            <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 1}. Section 1</p>
            <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
          </div>
        )}
        <div>
          <h2 class="font-display cs-section-heading">{sections[0].heading}</h2>
          <p class="cs-section-body">{sections[0].body}</p>
        </div>
      </div>
    </section>
  )}

  <!-- SECTION 2: text left, image right ──────────────────────── -->
  {sections.length > 1 && (
    <section class="cs-content-section cs-alt-bg">
      <div class="cs-two-col cs-two-col-rev">
        <div class="cs-text-first">
          <h2 class="font-display cs-section-heading">{sections[1].heading}</h2>
          <p class="cs-section-body">{sections[1].body}</p>
        </div>
        {images && images[2] ? (
          <div class="cs-img-wrap cs-img-second">
            <img src={images[2]} class="lb"
                 style="width:100%; height:100%; object-fit:cover; object-position:top left; display:block; cursor:zoom-in;" />
          </div>
        ) : (
          <div class="lb cs-img-wrap cs-img-second cs-placeholder" style="cursor:zoom-in;">
            <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 2}. Section 2</p>
            <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SECTION 3: image left, text right ──────────────────────── -->
  {sections.length > 2 && (
    <section class="cs-content-section">
      <div class="cs-two-col">
        {images && images[3] ? (
          <div class="cs-img-wrap">
            <img src={images[3]} class="lb"
                 style="width:100%; height:100%; object-fit:cover; object-position:top left; display:block; cursor:zoom-in;" />
          </div>
        ) : (
          <div class="lb cs-img-wrap cs-placeholder" style="cursor:zoom-in;">
            <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 3}. Section 3</p>
            <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
          </div>
        )}
        <div>
          <h2 class="font-display cs-section-heading">{sections[2].heading}</h2>
          <p class="cs-section-body">{sections[2].body}</p>
        </div>
      </div>
    </section>
  )}

  <!-- TAKEAWAYS ───────────────────────────────────────────────── -->
  {takeaways.length > 0 && (
    <section class="cs-content-section cs-alt-bg">
      <p class="cs-section-label">Key Takeaways</p>
      <div class="cs-takeaway-grid">
        {takeaways.map(t => (
          <div class="cs-takeaway-card">
            <p class="takeaway-text">{t}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- GALLERY ────────────────────────────────────────────────── -->
  <section class="cs-content-section">
    <div class="cs-gallery-grid">
      {images && images[4] ? (
        <div style="aspect-ratio:16/9; overflow:hidden; border-radius:12px;">
          <img src={images[4]} class="lb"
               style="width:100%; height:100%; object-fit:cover; object-position:top left; display:block; cursor:zoom-in;" />
        </div>
      ) : (
        <div class="lb cs-placeholder" style="aspect-ratio:16/9; border-radius:12px; cursor:zoom-in;">
          <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 4}. Gallery — Wide</p>
          <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
        </div>
      )}
      {images && images[5] ? (
        <img src={images[5]} class="lb"
             style="width:100%; display:block; cursor:zoom-in; border-radius:12px;" />
      ) : (
        <div class="lb cs-placeholder" style="border-radius:12px; min-height:180px; cursor:zoom-in;">
          <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 5}. Gallery — Detail</p>
          <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
        </div>
      )}
    </div>
  </section>

  <!-- SEE MORE WORK ───────────────────────────────────────────── -->
  <section class="cs-nav-section">
    <p class="cs-section-label">See More Work</p>
    <div class="cs-nav-grid">
      <a href={prevCase.href} class="cs-nav-card">
        <p class="cs-nav-dir">← Previous</p>
        <p class="cs-nav-eyebrow">{prevCase.eyebrow}</p>
        <h3 class="font-display cs-nav-title">{prevCase.title}</h3>
      </a>
      <a href={nextCase.href} class="cs-nav-card cs-nav-card-right">
        <p class="cs-nav-dir">Next →</p>
        <p class="cs-nav-eyebrow">{nextCase.eyebrow}</p>
        <h3 class="font-display cs-nav-title">{nextCase.title}</h3>
      </a>
    </div>
  </section>

  <!-- FOOTER ──────────────────────────────────────────────────── -->
  <footer style="text-align:center; padding:20px 0 40px;">
    <button onclick="window.scrollTo({top:0,behavior:'smooth'})"
            style="background:none; border:none; cursor:pointer; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); font-family:'Inter',sans-serif; margin-bottom:24px; display:block; width:100%;">
      Back to Top ↑
    </button>
    <div style="display:flex; justify-content:center; gap:40px; align-items:center;">
      <a href="https://www.linkedin.com/in/uxbrianthompson/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
         style="color:var(--silver); display:flex; align-items:center; transition:color 0.2s;"
         onmouseover="this.style.color='var(--dim-grey)'" onmouseout="this.style.color='var(--silver)'">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="mailto:uxbrianthompson@gmail.com" aria-label="Email"
         style="color:var(--silver); display:flex; align-items:center; transition:color 0.2s;"
         onmouseover="this.style.color='var(--dim-grey)'" onmouseout="this.style.color='var(--silver)'">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>
    </div>
  </footer>

  <!-- LIGHTBOX ────────────────────────────────────────────────── -->
  <div id="lb-overlay"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:9000; overflow-y:auto; cursor:zoom-out;"
       onclick="lbClose()">
    <div style="min-height:100%; display:flex; align-items:center; justify-content:center; padding:40px 20px; box-sizing:border-box;">
      <div id="lb-content" style="width:min(1200px,90vw); position:relative;">
        <p style="font-family:'Inter',sans-serif; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,.35); text-align:right; margin:0 0 12px;">click anywhere or esc to close</p>
      </div>
    </div>
  </div>

  <script is:inline>
    /* Lightbox */
    function lbOpen(html) {
      var c = document.getElementById('lb-content');
      var hint = c.querySelector('p');
      c.innerHTML = '';
      if (hint) c.appendChild(hint);
      var wrap = document.createElement('div');
      wrap.innerHTML = html;
      c.appendChild(wrap);
      document.getElementById('lb-overlay').style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
    function lbClose() {
      document.getElementById('lb-overlay').style.display = 'none';
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') lbClose(); });
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.lb').forEach(function(el) {
        el.style.cursor = 'zoom-in';
        el.addEventListener('click', function(e) {
          e.stopPropagation();
          var img = el.tagName === 'IMG' ? el : el.querySelector('img');
          if (img && img.src && !img.src.endsWith('/')) {
            lbOpen('<img src="' + img.src + '" style="width:100%; display:block; border-radius:8px;" alt="" />');
          } else {
            var label = el.innerText.trim().split('\n')[0].trim();
            lbOpen('<div style="font-family:monospace; font-size:3.5rem; font-weight:700; color:#f5f0e8; text-align:center; padding:3rem 2rem;">' + label + '</div>');
          }
        });
      });
    });

    /* Takeaway bold-first-sentence */
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.takeaway-text').forEach(function(el) {
        var text = el.textContent || '';
        var m = text.match(/^([^.!?]*[.!?])(\s*)([\s\S]*)/);
        if (m && m[3].trim()) {
          el.innerHTML = '<strong>' + m[1] + '</strong>' + m[2] + m[3];
        } else if (m) {
          el.innerHTML = '<strong>' + m[1] + '</strong>';
        }
      });
    });
  </script>
</body>
</html>

<style is:global>
  body { padding-top: 80px; }

  /* ── Hero ───────────────────────────────────────────────────── */
  .cs-hero       { padding: 80px 48px 48px; }
  .cs-eyebrow    { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--silver); margin: 0 0 16px; font-family: 'Inter', sans-serif; }
  .cs-title      { font-size: clamp(3rem, 8vw, 6.5rem); color: var(--ink); margin: 0 0 32px; line-height: 1; text-transform: uppercase; }
  .cs-meta       { display: flex; gap: 48px; margin-bottom: 32px; border-top: 1px solid var(--soft-linen); padding-top: 24px; }
  .cs-meta-label { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--silver); margin: 0 0 4px; font-family: 'Inter', sans-serif; }
  .cs-meta-value { font-size: 13px; color: var(--dim-grey); margin: 0; font-family: 'Inter', sans-serif; }
  .cs-summary    { font-size: 1.05rem; line-height: 1.75; color: var(--dim-grey); max-width: 720px; font-family: 'Inter', sans-serif; margin: 0; }

  .cs-hero-img-wrap { padding: 0 48px 80px; }

  /* ── Section wrappers ───────────────────────────────────────── */
  .cs-impact-section  { background: var(--soft-linen); padding: 64px 48px; }
  .cs-content-section { padding: 80px 48px; }
  .cs-content-section.cs-alt-bg { background: var(--soft-linen); }
  .cs-nav-section     { padding: 0 48px 80px; }

  .cs-section-label   { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--silver); margin: 0 0 32px; font-family: 'Inter', sans-serif; }

  /* ── Impact grid ────────────────────────────────────────────── */
  .cs-impact-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .cs-impact-item { font-size: 0.95rem; line-height: 1.65; color: var(--dim-grey); padding-left: 20px; border-left: 2px solid var(--silver); font-family: 'Inter', sans-serif; }

  /* ── Two-column content sections ────────────────────────────── */
  .cs-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }

  .cs-img-wrap {
    aspect-ratio: 3/2;
    overflow: hidden;
    border-radius: 12px;
  }
  .cs-placeholder {
    background: rgba(80,78,75,0.06);
    border: 1px dashed var(--silver);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    text-align: center;
  }

  .cs-section-heading { font-size: clamp(1.6rem, 2.5vw, 2.4rem); color: var(--ink); margin: 0 0 20px; line-height: 1.1; text-transform: uppercase; }
  .cs-section-body    { font-size: 1rem; line-height: 1.75; color: var(--dim-grey); margin: 0; font-family: 'Inter', sans-serif; }

  /* ── Section 2 — text left, image right (DOM: text, image) ─── */
  .cs-two-col-rev { }
  .cs-text-first  { }
  .cs-img-second  { }

  /* ── Takeaways ──────────────────────────────────────────────── */
  .cs-takeaway-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .cs-takeaway-card { padding: 28px; background: var(--parchment); border-radius: 12px; }
  .takeaway-text    { font-size: 0.95rem; line-height: 1.7; color: var(--dim-grey); margin: 0; font-family: 'Inter', sans-serif; }

  /* ── Gallery ────────────────────────────────────────────────── */
  .cs-gallery-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; align-items: start; }

  /* ── See More Work nav ──────────────────────────────────────── */
  .cs-nav-grid          { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cs-nav-card          { display: block; background: var(--soft-linen); border-radius: 14px; padding: 28px; text-decoration: none; transition: transform 0.2s; }
  .cs-nav-card:hover    { transform: translateY(-3px); }
  .cs-nav-card-right    { text-align: right; }
  .cs-nav-dir           { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--silver); margin: 0 0 4px; font-family: 'Inter', sans-serif; }
  .cs-nav-eyebrow       { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--silver); margin: 0 0 8px; font-family: 'Inter', sans-serif; }
  .cs-nav-title         { font-size: 1.8rem; color: var(--ink); margin: 0; text-transform: uppercase; }

  /* ── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .cs-hero          { padding: 60px 24px 40px; }
    .cs-hero-img-wrap { padding: 0 24px 56px; }
    .cs-title         { font-size: clamp(2.4rem, 10vw, 4rem); }
    .cs-meta          { gap: 32px; }

    .cs-impact-section  { padding: 48px 24px; }
    .cs-content-section { padding: 56px 24px; }
    .cs-nav-section     { padding: 0 24px 64px; }

    .cs-impact-grid   { grid-template-columns: 1fr; }
    .cs-two-col       { grid-template-columns: 1fr; gap: 32px; }
    .cs-takeaway-grid { grid-template-columns: 1fr; }
    .cs-gallery-grid  { grid-template-columns: 1fr; }
    .cs-nav-grid      { grid-template-columns: 1fr; }

    /* Section 2: image after text in DOM — push image first on mobile */
    .cs-img-second { order: -1; }

    .cs-nav-card-right { text-align: left; }
  }
</style>
