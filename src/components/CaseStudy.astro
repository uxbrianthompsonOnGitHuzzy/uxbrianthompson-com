---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "./Nav.astro";

const { title, eyebrow, role, year, prevCase, nextCase } = Astro.props;

const lorem    = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Viverra tempus, aliquet gravida sed convallis viverra. Nec porttitor vel eu malesuada volutpat ornare. Orci massa et diam laoreet.";
const loremLg  = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Viverra tempus, aliquet gravida sed convallis viverra. Nec porttitor vel eu malesuada volutpat ornare. Maecenas sollicitudin matris erat nisi, porttitor vel eu malesuada volutpat ornare. Orci massa et diam laoreet adipiscing viverra.";

const impact = [
  "56 features and enhancements shipped across 6 major releases",
  "17 zero-to-one AI innovations from concept to pilot",
  "11 active enterprise pilots with tier-1 wealth management firms",
  "Reduced estimated advisor daily task completion time by 40%",
];

const takeaways = [
  "Systems thinking accelerates delivery without sacrificing quality",
  "Human-in-the-loop architecture is required in regulated finance",
  "Agentic experiences earn trust through transparency and predictability",
  "The best AI features feel inevitable, not impressive",
];

const meta = [
  { label: "Role",     value: role },
  { label: "Year",     value: year },
  { label: "Platform", value: "Salesforce FSC" },
  { label: "Team",     value: "FSC Design, AI Platform, Eng" },
];
---
<BaseLayout>
  <Nav />

  <!-- HERO -->
  <section style="padding:64px 48px 80px; border-bottom:1px solid var(--border);">
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--dim-grey); font-family:Inter,sans-serif; margin:0 0 20px;">{eyebrow}</p>
    <h1 class="font-display" style="font-size:clamp(3rem,7vw,6rem); line-height:0.93; color:var(--text); margin:0 0 32px; max-width:18ch;">{title}</h1>
    <p style="font-size:16px; color:var(--text-dim); max-width:560px; line-height:1.75; font-family:Inter,sans-serif; margin:0 0 56px;">{lorem}</p>
    <div style="display:grid; grid-template-columns:3fr 2fr; gap:48px; max-width:860px;">
      <div>
        <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 16px;">Impact</p>
        <ul style="margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:10px;">
          {impact.map(item => (
            <li style="font-size:13px; color:var(--text-dim); font-family:Inter,sans-serif; padding-left:18px; position:relative; line-height:1.55;">
              <span style="position:absolute;left:0;color:var(--silver);">—</span>{item}
            </li>
          ))}
        </ul>
      </div>
      <div style="display:flex; flex-direction:column; gap:20px;">
        {meta.map(m => (
          <div>
            <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 3px;">{m.label}</p>
            <p style="font-size:13px; color:var(--text-dim); font-family:Inter,sans-serif; margin:0;">{m.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HERO IMAGE -->
  <div style="padding:64px 48px;">
    <div class="placeholder" style="width:100%; aspect-ratio:16/9; border-radius:16px;">Hero — Full-width visual</div>
  </div>

  <!-- SECTION 1: text left, image right -->
  <section style="padding:0 48px 80px;">
    <div style="display:grid; grid-template-columns:1fr 1.4fr; gap:56px; align-items:center;">
      <div>
        <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 12px;">Section One</p>
        <h2 class="font-display" style="font-size:clamp(1.8rem,3vw,2.8rem); color:var(--text); margin:0 0 20px; line-height:1.05;">The Problem Space</h2>
        <p style="font-size:14px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0 0 14px;">{loremLg}</p>
        <p style="font-size:14px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0;">{lorem}</p>
      </div>
      <div class="placeholder" style="aspect-ratio:4/3; border-radius:12px;">Visual A</div>
    </div>
  </section>

  <!-- SECTION 2: image left, text right — tinted bg -->
  <section style="background:var(--soft-linen); padding:80px 48px;">
    <div style="display:grid; grid-template-columns:1.4fr 1fr; gap:56px; align-items:center;">
      <div class="placeholder" style="aspect-ratio:4/3; border-radius:12px;">Visual B</div>
      <div>
        <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 12px;">Section Two</p>
        <h2 class="font-display" style="font-size:clamp(1.8rem,3vw,2.8rem); color:var(--text); margin:0 0 20px; line-height:1.05;">Design Decisions</h2>
        <p style="font-size:14px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0 0 14px;">{loremLg}</p>
        <p style="font-size:14px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0;">{lorem}</p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: text left, image right -->
  <section style="padding:80px 48px;">
    <div style="display:grid; grid-template-columns:1fr 1.4fr; gap:56px; align-items:center;">
      <div>
        <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 12px;">Section Three</p>
        <h2 class="font-display" style="font-size:clamp(1.8rem,3vw,2.8rem); color:var(--text); margin:0 0 20px; line-height:1.05;">The System in Motion</h2>
        <p style="font-size:14px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0 0 14px;">{loremLg}</p>
        <p style="font-size:14px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0;">{lorem}</p>
      </div>
      <div class="placeholder" style="aspect-ratio:4/3; border-radius:12px;">Visual C</div>
    </div>
  </section>

  <!-- GALLERY -->
  <section style="padding:0 48px 80px;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 20px;">Gallery</p>
    <div style="display:grid; grid-template-columns:2fr 1fr; grid-template-rows:1fr 1fr; gap:12px;">
      <div class="placeholder" style="grid-row:1/3; aspect-ratio:3/4; border-radius:12px;">Large</div>
      <div class="placeholder" style="aspect-ratio:16/9; border-radius:12px;">Detail A</div>
      <div class="placeholder" style="aspect-ratio:16/9; border-radius:12px;">Detail B</div>
    </div>
  </section>

  <!-- CONCLUSION -->
  <section style="background:var(--soft-linen); padding:80px 48px;">
    <div style="max-width:680px;">
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 16px;">Conclusion</p>
      <h2 class="font-display" style="font-size:clamp(2rem,4vw,3.5rem); color:var(--text); margin:0 0 24px; line-height:1.05;">Takeaways</h2>
      <p style="font-size:15px; color:var(--text-dim); line-height:1.8; font-family:Inter,sans-serif; margin:0 0 32px;">{loremLg}</p>
      <ul style="margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:14px;">
        {takeaways.map(item => (
          <li style="font-size:14px; color:var(--text-dim); font-family:Inter,sans-serif; padding-left:20px; position:relative; line-height:1.65;">
            <span style="position:absolute;left:0;color:var(--dim-grey);font-weight:700;">↗</span>{item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SEE MORE WORK -->
  <section style="padding:80px 48px;">
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); font-family:Inter,sans-serif; margin:0 0 24px;">See More Work</p>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <a href={prevCase.href} style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:24px; display:flex; flex-direction:column; gap:16px;">
          <div class="placeholder" style="width:100%; aspect-ratio:16/9; border-radius:10px; font-size:0;">img</div>
          <div>
            <p style="font-size:9px; letter-spacing:0.14em; text-transform:uppercase; color:var(--dim-grey); font-family:Inter,sans-serif; margin:0 0 4px;">&#8592; Previous</p>
            <p class="font-display" style="font-size:1.5rem; color:var(--dark-warm); margin:0; line-height:1.1;">{prevCase.title}</p>
          </div>
        </div>
      </a>
      <a href={nextCase.href} style="display:block; background:var(--silver); border-radius:16px; text-decoration:none; transition:transform 0.3s;"
         onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:24px; display:flex; flex-direction:column; gap:16px;">
          <div class="placeholder" style="width:100%; aspect-ratio:16/9; border-radius:10px; font-size:0;">img</div>
          <div>
            <p style="font-size:9px; letter-spacing:0.14em; text-transform:uppercase; color:var(--dim-grey); font-family:Inter,sans-serif; margin:0 0 4px;">Next &#8594;</p>
            <p class="font-display" style="font-size:1.5rem; color:var(--dark-warm); margin:0; line-height:1.1;">{nextCase.title}</p>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="text-align:center; padding:40px 0;">
    <button onclick="window.scrollTo({top:0,behavior:'smooth'})"
      style="background:none; border:none; cursor:pointer; font-family:Inter,sans-serif; font-size:11px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; color:var(--dim-grey); padding:0;">
      &#8593; &nbsp; Back To Top &nbsp; &#8593;
    </button>
    <div style="margin-top:40px; display:flex; align-items:center; justify-content:center; gap:40px;">
      <a href="https://www.linkedin.com/in/uxbrianthompson/" target="_blank" rel="noopener"
         style="color:var(--silver); transition:color 0.2s;"
         onmouseover="this.style.color='var(--dim-grey)'" onmouseout="this.style.color='var(--silver)'">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="mailto:uxbrianthompson@gmail.com"
         style="color:var(--silver); transition:color 0.2s;"
         onmouseover="this.style.color='var(--dim-grey)'" onmouseout="this.style.color='var(--silver)'">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>
    </div>
    <div style="margin-top:40px;"></div>
  </footer>

</BaseLayout>
