---
import Nav from "./Nav.astro";
import '../styles/global.css';

interface CaseSection { heading: string; body: string; }
interface PrevNext { title: string; href: string; eyebrow: string; }
interface Props {
  title: string;
  eyebrow: string;
  role: string;
  year: string;
  summary?: string;
  bullets?: string[];
  sections?: CaseSection[];
  takeaways?: string[];
  imageStart?: number;
  prevCase: PrevNext;
  nextCase: PrevNext;
}

const {
  title, eyebrow, role, year,
  summary = "",
  bullets = [],
  sections = [],
  takeaways = [],
  imageStart = 0,
  prevCase, nextCase,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Brian Thompson</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav />

  <!-- HERO -->
  <section style="max-width:1100px; margin:0 auto; padding:80px 48px 48px;">
    <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 16px; font-family:'Inter',sans-serif;">{eyebrow}</p>
    <h1 class="font-display" style="font-size:clamp(3rem,8vw,6.5rem); color:var(--ink); margin:0 0 32px; line-height:1; text-transform:uppercase;">{title}</h1>
    <div style="display:flex; gap:48px; margin-bottom:32px; border-top:1px solid var(--soft-linen); padding-top:24px;">
      <div>
        <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); margin:0 0 4px; font-family:'Inter',sans-serif;">Role</p>
        <p style="font-size:13px; color:var(--dim-grey); margin:0; font-family:'Inter',sans-serif;">{role}</p>
      </div>
      <div>
        <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); margin:0 0 4px; font-family:'Inter',sans-serif;">Year</p>
        <p style="font-size:13px; color:var(--dim-grey); margin:0; font-family:'Inter',sans-serif;">{year}</p>
      </div>
    </div>
    {summary && (
      <p style="font-size:1.05rem; line-height:1.75; color:var(--dim-grey); max-width:720px; font-family:'Inter',sans-serif; margin:0;">{summary}</p>
    )}
  </section>

  <!-- HERO IMAGE -->
  <div style="max-width:1100px; margin:0 auto; padding:0 48px 80px;">
    <div style="width:100%; aspect-ratio:16/9; background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;">
      <p style="font-size:13px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0; letter-spacing:0.04em;">{imageStart}. {title} — Case Study Hero</p>
      <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.14em; text-transform:uppercase;">Hero Image · Figma Export</p>
    </div>
  </div>

  <!-- IMPACT -->
  {bullets.length > 0 && (
    <section style="background:var(--soft-linen); padding:64px 48px;">
      <div style="max-width:1100px; margin:0 auto;">
        <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 32px; font-family:'Inter',sans-serif;">Impact</p>
        <ul style="list-style:none; padding:0; margin:0; display:grid; grid-template-columns:1fr 1fr; gap:24px;">
          {bullets.map(b => (
            <li style="font-size:0.95rem; line-height:1.65; color:var(--dim-grey); padding-left:20px; border-left:2px solid var(--silver); font-family:'Inter',sans-serif;">{b}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- SECTION 1: image left, text right -->
  {sections.length > 0 && (
    <section style="padding:80px 48px;">
      <div style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
        <div class="lb" style="aspect-ratio:3/2; background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:16px; text-align:center; cursor:zoom-in;">
          <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 1}. Section 1</p>
          <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
        </div>
        <div>
          <h2 class="font-display" style="font-size:clamp(1.6rem,2.5vw,2.4rem); color:var(--ink); margin:0 0 20px; line-height:1.1; text-transform:uppercase;">{sections[0].heading}</h2>
          <p style="font-size:1rem; line-height:1.75; color:var(--dim-grey); margin:0; font-family:'Inter',sans-serif;">{sections[0].body}</p>
        </div>
      </div>
    </section>
  )}

  <!-- SECTION 2: text left, image right (tinted) -->
  {sections.length > 1 && (
    <section style="background:var(--soft-linen); padding:80px 48px;">
      <div style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
        <div>
          <h2 class="font-display" style="font-size:clamp(1.6rem,2.5vw,2.4rem); color:var(--ink); margin:0 0 20px; line-height:1.1; text-transform:uppercase;">{sections[1].heading}</h2>
          <p style="font-size:1rem; line-height:1.75; color:var(--dim-grey); margin:0; font-family:'Inter',sans-serif;">{sections[1].body}</p>
        </div>
        <div class="lb" style="aspect-ratio:3/2; background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:16px; text-align:center; cursor:zoom-in;">
          <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 2}. Section 2</p>
          <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
        </div>
      </div>
    </section>
  )}

  <!-- SECTION 3: image left, text right -->
  {sections.length > 2 && (
    <section style="padding:80px 48px;">
      <div style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
        <div class="lb" style="aspect-ratio:3/2; background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:16px; text-align:center; cursor:zoom-in;">
          <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 3}. Section 3</p>
          <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
        </div>
        <div>
          <h2 class="font-display" style="font-size:clamp(1.6rem,2.5vw,2.4rem); color:var(--ink); margin:0 0 20px; line-height:1.1; text-transform:uppercase;">{sections[2].heading}</h2>
          <p style="font-size:1rem; line-height:1.75; color:var(--dim-grey); margin:0; font-family:'Inter',sans-serif;">{sections[2].body}</p>
        </div>
      </div>
    </section>
  )}

  <!-- TAKEAWAYS -->
  {takeaways.length > 0 && (
    <section style="background:var(--soft-linen); padding:80px 48px;">
      <div style="max-width:1100px; margin:0 auto;">
        <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 40px; font-family:'Inter',sans-serif;">Key Takeaways</p>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
          {takeaways.map(t => (
            <div style="padding:28px; background:var(--parchment); border-radius:12px;">
              <p style="font-size:0.95rem; line-height:1.7; color:var(--dim-grey); margin:0; font-family:'Inter',sans-serif;">{t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- GALLERY -->
  <section style="padding:80px 48px;">
    <div style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:2fr 1fr; gap:16px; align-items:stretch;">
      <div class="lb" style="aspect-ratio:16/9; background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; cursor:zoom-in;">
        <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 4}. Gallery — Wide</p>
        <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
      </div>
      <div class="lb" style="background:rgba(80,78,75,0.06); border:1px dashed var(--silver); border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; cursor:zoom-in;">
        <p style="font-size:12px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0;">{imageStart + 5}. Gallery — Detail</p>
        <p style="font-size:10px; color:var(--silver); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.12em; text-transform:uppercase;">Figma Export</p>
      </div>
    </div>
  </section>

  <!-- SEE MORE WORK -->
  <section style="padding:0 48px 80px;">
    <div style="max-width:1100px; margin:0 auto;">
      <p style="font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); margin:0 0 24px; font-family:'Inter',sans-serif;">See More Work</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <a href={prevCase.href} style="display:block; background:var(--soft-linen); border-radius:14px; padding:28px; text-decoration:none; transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
          <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); margin:0 0 4px; font-family:'Inter',sans-serif;">← Previous</p>
          <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); margin:0 0 8px; font-family:'Inter',sans-serif;">{prevCase.eyebrow}</p>
          <h3 class="font-display" style="font-size:1.8rem; color:var(--ink); margin:0; text-transform:uppercase;">{prevCase.title}</h3>
        </a>
        <a href={nextCase.href} style="display:block; background:var(--soft-linen); border-radius:14px; padding:28px; text-decoration:none; transition:transform 0.2s; text-align:right;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
          <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); margin:0 0 4px; font-family:'Inter',sans-serif;">Next →</p>
          <p style="font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--silver); margin:0 0 8px; font-family:'Inter',sans-serif;">{nextCase.eyebrow}</p>
          <h3 class="font-display" style="font-size:1.8rem; color:var(--ink); margin:0; text-transform:uppercase;">{nextCase.title}</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="text-align:center; padding:20px 0 40px;">
    <button onclick="window.scrollTo({top:0,behavior:'smooth'})" style="background:none; border:none; cursor:pointer; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--silver); font-family:'Inter',sans-serif; margin-bottom:24px; display:block; width:100%;">Back to Top ↑</button>
    <div style="display:flex; justify-content:center; gap:40px; align-items:center;">
      <a href="https://www.linkedin.com/in/uxbrianthompson/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" style="color:var(--silver); display:flex; align-items:center;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:uxbrianthompson@gmail.com" aria-label="Email" style="color:var(--silver); display:flex; align-items:center;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </a>
    </div>
  </footer>

  <!-- LIGHTBOX -->
  <div id="lb-overlay" style="display:none; position:fixed; inset:0; background:rgba(20,18,16,0.92); z-index:9999; align-items:center; justify-content:center; cursor:zoom-out;" onclick="this.style.display='none'">
    <div style="max-width:88vw; max-height:88vh; background:rgba(80,78,75,0.1); border:1px dashed rgba(184,181,176,0.4); border-radius:16px; padding:48px 56px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; min-width:55vw; min-height:38vh;">
      <p id="lb-label" style="font-size:15px; font-weight:700; color:#cc00cc; font-family:'Inter',sans-serif; margin:0; text-align:center;"></p>
      <p style="font-size:10px; color:rgba(184,181,176,0.6); font-family:'Inter',sans-serif; margin:0; letter-spacing:0.16em; text-transform:uppercase;">Figma export placeholder · click to close</p>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.lb').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.stopPropagation();
        var label = el.querySelector('p') ? el.querySelector('p').textContent : '';
        document.getElementById('lb-label').textContent = label;
        document.getElementById('lb-overlay').style.display = 'flex';
      });
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') document.getElementById('lb-overlay').style.display = 'none';
    });
  </script>

</body>
</html>

<style is:global>
  body { padding-top: 80px; }
</style>
