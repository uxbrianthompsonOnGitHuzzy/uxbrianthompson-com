---
const all=[{l:'FSC Agentic Experience',h:'/fsc',bg:'#0d1b34'},{l:'Bank of America',h:'/bank-of-america',bg:'#5c1520'},{l:'Google',h:'/google',bg:'#1e2d1f'},{l:'Funimation',h:'/funimation',bg:'#2d1050'},{l:'Apple',h:'/apple',bg:'#1e1e22'},{l:'Audi',h:'/audi',bg:'#1a1520'}];
const cur=Astro.url.pathname;
const cards=all.filter(p=>p.h!==cur).slice(0,4);
---
<section style="border-top:1px solid var(--border);margin-top:96px;padding:40px 48px 64px;">
  <p style="font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--blue-dim);margin:0 0 20px;font-family:'Inter',sans-serif;">More Work</p>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
    {cards.map(c=>(
      <a href={c.h} style={`display:block;background:${c.bg};border-radius:12px;text-decoration:none;transition:transform .25s;`} onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="padding:24px;height:128px;display:flex;align-items:flex-end;">
          <span class="font-display" style="color:#fff;font-size:16px;line-height:1.1;">{c.l}</span>
        </div>
      </a>
    ))}
  </div>
</section>