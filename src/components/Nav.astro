---
const currentPath = Astro.url.pathname;
const links = [
  { label: 'Work',      href: '/' },
  { label: 'Resume',    href: '/resume' },
  { label: 'About',     href: '/about' },
  { label: 'Contact ↗', href: 'mailto:uxbrianthompson@gmail.com', external: true },
];
---
<nav style="display:flex; align-items:center; justify-content:space-between; padding:24px 48px; border-bottom:1px solid var(--border);">
  <div>
    <div style="font-size:13px; font-weight:500; color:var(--text); letter-spacing:0.02em;">Brian Thompson</div>
    <div style="font-size:10px; color:var(--accent); letter-spacing:0.14em; text-transform:uppercase; margin-top:2px;">AI Product Design</div>
  </div>
  <ul style="display:flex; gap:32px; list-style:none; margin:0; padding:0;">
    {links.map(link => {
      const active = link.href !== '/' ? currentPath.startsWith(link.href) : currentPath === '/';
      return (
        <li>
          
            href={link.href}
            target={link.external ? '_blank' : undefined}
            style={`font-size:11px; letter-spacing:0.1em; text-transform:uppercase; text-decoration:none; transition:color 0.2s;
              color:${active ? 'var(--text)' : 'var(--accent-dim)'};
              border-bottom:${active ? '1px solid var(--accent)' : 'none'};
              padding-bottom:${active ? '2px' : '0'};`}
          >
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
