---
const currentPath = Astro.url.pathname;
const links = [
  { label: 'Work',      href: '/' },
  { label: 'Resume',    href: '/resume' },
  { label: 'About',     href: '/about' },
  { label: 'Contact ↗', href: 'mailto:uxbrianthompson@gmail.com', external: true },
];
---
<nav>
  <div class="nav-brand">
    <div class="nav-name">Brian Thompson</div>
    <div class="nav-sub">AI Product Design</div>
  </div>
  <ul class="nav-links">
    {links.map(link => {
      const active = link.href !== '/' ? currentPath.startsWith(link.href) : currentPath === '/';
      return (
        <li>
          
            href={link.href}
            target={link.external ? '_blank' : undefined}
            class={active ? 'nav-link active' : 'nav-link'}
          >
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    border-bottom: 1px solid var(--border);
  }
  .nav-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .nav-sub {
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 2px;
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent-dim);
    transition: color 0.2s;
  }
  .nav-link.active {
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }
</style>
