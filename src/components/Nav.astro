---
const currentPath = Astro.url.pathname;

const workItems = [
  { label: "Salesforce",  href: "/fsc" },
  { label: "BofA",        href: "/bank-of-america" },
  { label: "Google",      href: "/google" },
  { label: "Crunchyroll", href: "/funimation" },
  { label: "Apple",       href: "/apple" },
  { label: "Audi",        href: "/audi" },
];

const navLinks = [
  { label: "Resume",    href: "/resume",                               external: false },
  { label: "About",     href: "/about",                                external: false },
  { label: "Contact ↗", href: "mailto:uxbrianthompson@gmail.com",      external: true  },
];
---

<nav id="site-nav">
  <a href="/" class="nav-brand" aria-label="Home">
    <div class="nav-name">BRIAN THOMPSON</div>
    <div class="nav-sub">AI Product Design</div>
  </a>

  <ul class="nav-links">

    <!-- Work + dropdown -->
    <li class="nav-item has-dropdown">
      <a href="/" class={currentPath === "/" ? "nav-link active" : "nav-link"}>Work</a>
      <div class="dropdown" role="menu">
        {workItems.map(item => (
          <a href={item.href} class="dropdown-item" role="menuitem">{item.label}</a>
        ))}
      </div>
    </li>

    <!-- Remaining links -->
    {navLinks.map(link => {
      const active = !link.external && currentPath.startsWith(link.href);
      return (
        <li class="nav-item">
          
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener" : undefined}
            class={active ? "nav-link active" : "nav-link"}
          >
            {link.label}
          </a>
        </li>
      );
    })}

  </ul>
</nav>

<!-- Offset body for fixed nav -->
<style is:global>
  body { padding-top: 80px; }
</style>

<style>
  /* ── Base nav ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    background: transparent;
    transition: padding 0.28s ease, background 0.28s ease, backdrop-filter 0.28s ease,
                box-shadow 0.28s ease;
  }

  /* ── Scrolled / sticky state ── */
  nav.scrolled {
    padding: 13px 48px;
    background: rgba(245, 244, 239, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(104,103,99,0.12);
  }

  /* ── Brand ── */
  .nav-brand { text-decoration: none; }
  .nav-name  { font-size: 13px; font-weight: 700; color: var(--text); letter-spacing: 0.08em; text-transform: uppercase; }
  .nav-sub   { font-size: 10px; color: var(--dim-grey); letter-spacing: 0.14em; text-transform: uppercase; margin-top: 2px; }

  /* ── Links row ── */
  .nav-links { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; align-items: center; }
  .nav-item  { position: relative; }

  .nav-link {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .nav-link:hover         { color: var(--text); }
  .nav-link.active        { color: var(--text); border-bottom: 1px solid var(--dim-grey); padding-bottom: 2px; }

  /* ── Dropdown card ── */
  .dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background: rgba(40, 38, 36, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 12px;
    padding: 6px;
    min-width: 172px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.28), 0 2px 8px rgba(0,0,0,0.14);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  /* Bridge gap so cursor can travel from link to dropdown */
  .dropdown::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 0; right: 0;
    height: 14px;
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* ── Dropdown items ── */
  .dropdown-item {
    display: block;
    padding: 9px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--silver);
    border-radius: 7px;
    font-family: "Barlow Condensed", sans-serif;
    transition: background 0.14s, color 0.14s;
  }
  .dropdown-item:hover {
    background: rgba(255,255,255,0.09);
    color: var(--parchment);
  }
</style>

<script is:inline>
  const nav = document.getElementById("site-nav");
  function syncNav() {
    nav.classList.toggle("scrolled", window.scrollY > 60);
  }
  window.addEventListener("scroll", syncNav, { passive: true });
  syncNav();
</script>
