---

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Brian Thompson — Senior Product Designer",
  description = "Senior Product Designer specializing in Human\u2013AI Systems, Agentic Workflows, and Decision Intelligence. Currently at Salesforce Financial Services Cloud.",
} = Astro.props;

const pageTitle = title === "Brian Thompson \u2014 Senior Product Designer"
  ? title
  : `${title} \u2014 Brian Thompson`;
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>
  <meta name="description" content={description}/>
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;700;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet"/>
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
</head>
<body>
  <slot/>
</body>
</html>